<?xml version="1.0" encoding="utf-8"?>
<aiscript name="lib.gt.maintenance.execute" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../stock_game/X4 Foundations/libraries/aiscripts.xsd" version="1">
  <!--
    Unified GT maintenance executor (MK3/MK4 reference pattern).
    MD publishes prepared repair/resupply tables; this library
    creates Repair / Equip build orders and waits for GT_Maintenance_Complete.
    Sets this.$maintenance_transition on the caller while child maintenance orders are active.
  -->
  <params>
    <param name="ship" default="this.ship"/>
    <param name="logPrefix" default="'GT-AI'"/>
    <param name="mdPrepareWait" default="0.5s" comment="Legacy caller compatibility; preparation now uses a readiness signal."/>
  </params>
  <attention min="unknown">
    <actions>
      <do_if value="not $ship? or not @$ship.exists">
        <return value="true"/>
      </do_if>

      <run_script name="'lib.gt.ship.opstate'">
        <param name="ship" value="$ship"/>
        <param name="opState" value="'Rerouting'"/>
        <param name="active" value="false"/>
        <param name="refreshName" value="true"/>
        <param name="reason" value="'maintenance_entry'"/>
      </run_script>

      <!-- Reconcile saved waiting flags with engine orders/builds. Prepared descriptors are not
           active orders, and a cancelled or legacy orphan must not suppress the next dispatch. -->
      <set_value name="$activeRepair" exact="@$ship.order.id == 'Repair'"/>
      <set_value name="$activeEquipment" exact="@$ship.order.id == 'Equip' or @$ship.order.id == 'Resupply' or @global.$GT_MaintenanceOrders.{$ship}.$EquipmentBuild.exists"/>
      <do_all exact="$ship.orders.count" counter="$maintenanceOrderIdx">
        <set_value name="$maintenanceOrder" exact="$ship.orders.{$maintenanceOrderIdx}"/>
        <do_if value="@$maintenanceOrder.id == 'Repair'"><set_value name="$activeRepair" exact="true"/></do_if>
        <do_if value="@$maintenanceOrder.id == 'Equip' or @$maintenanceOrder.id == 'Resupply'"><set_value name="$activeEquipment" exact="true"/></do_if>
      </do_all>
      <do_if value="global.$GT_MaintenanceOrders? and global.$GT_MaintenanceOrders.{$ship}?">
        <!-- Preparation is synchronous once dequeued, so a row still Preparing after 120s lost its
             request (ExecuteMaintenance action block aborted, or the load-time queue reset dropped
             it). Without this it suppresses dispatch forever; the checks below then re-issue. -->
        <do_if value="@global.$GT_MaintenanceOrders.{$ship}.$Preparing and (player.age - global.$GT_MaintenanceOrders.{$ship}.$StartTime) gt 120s">
          <set_value name="global.$GT_MaintenanceOrders.{$ship}.$Preparing" exact="false"/>
        </do_if>
        <set_value name="global.$GT_MaintenanceOrders.{$ship}.$WaitingForRepair" exact="$activeRepair"/>
        <set_value name="global.$GT_MaintenanceOrders.{$ship}.$WaitingForEquipment" exact="$activeEquipment"/>
        <do_if value="not @global.$GT_MaintenanceOrders.{$ship}.$Preparing and not @global.$GT_MaintenanceOrders.{$ship}.$Prepared and not $activeRepair and not $activeEquipment">
          <do_if value="@global.$GT_RepairOrders.{$ship} != null or @global.$GT_ResupplyOrders.{$ship} != null">
            <set_value name="global.$GT_MaintenanceOrders.{$ship}.$Prepared" exact="true"/>
          </do_if>
          <do_else>
            <remove_value name="global.$GT_MaintenanceOrders.{$ship}"/>
          </do_else>
        </do_if>
      </do_if>
      <set_value name="$maintenanceInFlight" exact="$activeRepair or $activeEquipment"/>
      <do_if value="not $maintenanceInFlight and not @global.$GT_MaintenanceOrders.{$ship}.$Prepared">
        <do_if value="not @global.$GT_MaintenanceOrders.{$ship}.$Preparing">
          <signal_objects object="player.galaxy" param="'GT_DoMaintenance'" param2="$ship"/>
        </do_if>
        <!-- Persistent Prepared state handles early signals; the signal wakes a queued request.
             If the bounded wait expires, the next executor adopts this same pending request. -->
        <wait max="30s">
          <interrupt>
            <conditions><event_object_signalled object="$ship" param="'GT_Maintenance_Prepared'"/></conditions>
          </interrupt>
        </wait>
      </do_if>
      <do_if value="not $maintenanceInFlight and not @global.$GT_MaintenanceOrders.{$ship}.$Prepared">
        <return value="true"/>
      </do_if>

      <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
        <set_value name="$diagHasRepair" exact="global.$GT_RepairOrders? and global.$GT_RepairOrders.{$ship}?"/>
        <set_value name="$diagHasResupply" exact="global.$GT_ResupplyOrders? and global.$GT_ResupplyOrders.{$ship}?"/>
        <debug_text text="'[' + $logPrefix + '] ' + $ship.idcode + ': Maintenance check result: RepairOrder=' + $diagHasRepair + ', ResupplyOrder=' + $diagHasResupply + ', HullPct=' + $ship.hullpercentage + '%, InFlight=' + $maintenanceInFlight" chance="100"/>
      </do_if>

      <do_if value="not $activeRepair and global.$GT_RepairOrders? and global.$GT_RepairOrders.{$ship}?">
        <set_value name="$repairData" exact="global.$GT_RepairOrders.{$ship}"/>
        <set_value name="$repairStation" exact="$repairData.$Station"/>
        <set_value name="$repairOrderIssued" exact="false"/>

        <set_value name="$canDockRepair" exact="false"/>
        <do_if value="@$repairStation.exists">
          <run_script name="'lib.gt.dockcheck'" result="$repairDockResult">
            <param name="ship" value="$ship"/>
            <param name="station" value="$repairStation"/>
            <param name="purpose" value="'service_ai'"/>
          </run_script>
          <set_value name="$canDockRepair" exact="$repairDockResult.$CanDock"/>
          <do_if value="not $canDockRepair">
            <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
              <debug_text text="'[' + $logPrefix + '] ' + $ship.idcode + ': Repair docking check FAILED: ' + @$repairStation.knownname +
                '\n  Sector: ' + @$repairStation.sector.knownname +
                '\n  Reason: No dock available for ship size ' + $ship.docksize +
                '\n  -> Clearing repair order and continuing...'"
                chance="100"/>
            </do_if>
            <remove_value name="global.$GT_RepairOrders.{$ship}"/>
          </do_if>
        </do_if>

        <!-- Hull may already be healthy if repair finished but global.$GT_RepairOrders was not cleared yet. -->
        <set_value name="$hullAlreadyHealthy" exact="false"/>
        <do_if value="@global.$GT_GlobalSettings.$AutoRepair.$Enabled">
          <set_value name="$repairThreshold" exact="@global.$GT_GlobalSettings.$AutoRepair.$HullThreshold"/>
          <do_if value="$ship.hullpercentage ge $repairThreshold">
            <set_value name="$hullAlreadyHealthy" exact="true"/>
          </do_if>
        </do_if>
        <do_if value="$hullAlreadyHealthy">
          <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
            <debug_text text="'[' + $logPrefix + '] ' + $ship.idcode + ': Hull already at ' + $ship.hullpercentage + '% (threshold ' + $repairThreshold + '%) - skipping stale repair order'" chance="100"/>
          </do_if>
          <remove_value name="global.$GT_RepairOrders.{$ship}"/>
        </do_if>
        <do_elseif value="$canDockRepair">
          <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
            <debug_text text="'[' + $logPrefix + '] ' + $ship.idcode + ': Creating Repair order at ' + $repairStation.knownname" chance="100"/>
          </do_if>
          <set_value name="this.$maintenance_transition" exact="true"/>
          <create_order object="$ship" id="'Repair'" immediate="false" priority="true" name="$issuedRepair">
            <param name="destination" value="$repairStation"/>
            <param name="hullpercent" value="100"/>
            <param name="repairall" value="true"/>
            <param name="acceptedcost" value="$repairData.$AcceptedCost"/>
            <param name="urgent" value="false"/>
            <param name="internalorder" value="true"/>
          </create_order>
          <remove_value name="global.$GT_RepairOrders.{$ship}"/>
          <set_value name="$repairOrderIssued" exact="@$issuedRepair.exists"/>
          <set_value name="global.$GT_MaintenanceOrders.{$ship}.$WaitingForRepair" exact="$repairOrderIssued"/>
          <run_script name="'lib.gt.attention.refresh_ship_name'">
            <param name="ship" value="$ship"/>
            <param name="force" value="true"/>
          </run_script>
        </do_elseif>
        <!-- Rejected descriptors are consumed without creating an active maintenance leg. -->
        <do_if value="not $repairOrderIssued">
          <do_if value="global.$GT_RepairOrders.{$ship}?">
            <remove_value name="global.$GT_RepairOrders.{$ship}"/>
          </do_if>
          <do_if value="global.$GT_MaintenanceOrders? and global.$GT_MaintenanceOrders.{$ship}?">
            <set_value name="global.$GT_MaintenanceOrders.{$ship}.$WaitingForRepair" exact="false"/>

          </do_if>
        </do_if>
      </do_if>

      <do_if value="not $activeEquipment and global.$GT_ResupplyOrders? and global.$GT_ResupplyOrders.{$ship}?">
        <set_value name="$resupplyData" exact="global.$GT_ResupplyOrders.{$ship}"/>
        <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
          <debug_text text="'[' + $logPrefix + '] ' + $ship.idcode + ': CREATING RESUPPLY BUILD ORDER at ' + $resupplyData.$Station.knownname" chance="100"/>
        </do_if>

        <set_value name="$buildSuccessful" exact="false"/>
        <set_value name="$ammoTableKeys" exact="@$resupplyData.$AmmoTable.keys"/>
        <set_value name="$ammoTableCount" exact="@$ammoTableKeys.count"/>
        <set_value name="$unitTableKeys" exact="@$resupplyData.$UnitTable.keys"/>
        <set_value name="$unitTableCount" exact="@$unitTableKeys.count"/>

        <do_if value="@$ammoTableCount gt 0 or @$unitTableCount gt 0">
          <set_value name="$resupplyStation" exact="$resupplyData.$Station"/>
          <set_value name="$canDockResupply" exact="false"/>
          <do_if value="@$resupplyStation.exists">
            <run_script name="'lib.gt.dockcheck'" result="$resupplyDockResult">
              <param name="ship" value="$ship"/>
              <param name="station" value="$resupplyStation"/>
              <param name="purpose" value="'service_ai'"/>
            </run_script>
            <set_value name="$canDockResupply" exact="$resupplyDockResult.$CanDock"/>
            <do_if value="not $canDockResupply">
              <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
                <debug_text text="'[' + $logPrefix + '] ' + $ship.idcode + ': Resupply docking check FAILED: ' + @$resupplyStation.knownname +
                  '\n  Sector: ' + @$resupplyStation.sector.knownname +
                  '\n  Reason: No dock available for ship size ' + $ship.docksize +
                  '\n  -> Clearing resupply order and continuing...'"
                  chance="100"/>
              </do_if>
              <remove_value name="global.$GT_ResupplyOrders.{$ship}"/>
            </do_if>
          </do_if>

          <do_if value="$canDockResupply">
            <set_value name="this.$maintenance_transition" exact="true"/>
            <add_build_to_modify_ship
                object="$resupplyStation"
                buildobject="$ship"
                ammo="$resupplyData.$AmmoTable"
                units="$resupplyData.$UnitTable"
                immediate="false"
                internal="true"
                result="$buildSuccessful"/>
            <do_if value="$buildSuccessful">
              <set_value name="global.$GT_MaintenanceOrders.{$ship}.$EquipmentBuild" exact="$buildSuccessful"/>
              <set_value name="global.$GT_MaintenanceOrders.{$ship}.$WaitingForEquipment" exact="true"/>
            </do_if>


            <do_if value="not $buildSuccessful">
              <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
                <debug_text text="'[' + $logPrefix + '] ' + $ship.idcode + ': FAILED to create build order at ' + $resupplyStation.knownname" chance="100"/>
              </do_if>
              <remove_value name="global.$GT_ResupplyOrders.{$ship}"/>
              <do_if value="not global.$GT_MaintenanceFailedResupply?">
                <set_value name="global.$GT_MaintenanceFailedResupply" exact="table[]"/>
              </do_if>
              <set_value name="global.$GT_MaintenanceFailedResupply.{$ship}" exact="player.age + 300s"/>
              <do_if value="global.$GT_MaintenanceOrders? and global.$GT_MaintenanceOrders.{$ship}?">
                <set_value name="global.$GT_MaintenanceOrders.{$ship}.$WaitingForEquipment" exact="false"/>
              </do_if>

            </do_if>
          </do_if>
          <!-- No build was issued; consume only the equipment descriptor. -->
          <do_else>
            <do_if value="global.$GT_ResupplyOrders.{$ship}?">
              <remove_value name="global.$GT_ResupplyOrders.{$ship}"/>
            </do_if>
            <do_if value="global.$GT_MaintenanceOrders? and global.$GT_MaintenanceOrders.{$ship}?">
              <set_value name="global.$GT_MaintenanceOrders.{$ship}.$WaitingForEquipment" exact="false"/>

            </do_if>
          </do_else>
        </do_if>
        <do_else>
          <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
            <debug_text text="'[' + $logPrefix + '] ' + $ship.idcode + ': Empty resupply shopping list - clearing tracking'" chance="100"/>
          </do_if>
          <remove_value name="global.$GT_ResupplyOrders.{$ship}"/>
          <do_if value="global.$GT_MaintenanceOrders? and global.$GT_MaintenanceOrders.{$ship}?">
            <set_value name="global.$GT_MaintenanceOrders.{$ship}.$WaitingForEquipment" exact="false"/>
          </do_if>

        </do_else>
      </do_if>

      <do_if value="global.$GT_MaintenanceOrders? and global.$GT_MaintenanceOrders.{$ship}?">
        <set_value name="global.$GT_MaintenanceOrders.{$ship}.$Prepared" exact="false"/>
      </do_if>
      <set_value name="$maintenanceInFlight" exact="@global.$GT_MaintenanceOrders.{$ship}.$WaitingForRepair or @global.$GT_MaintenanceOrders.{$ship}.$WaitingForEquipment"/>
      <do_if value="$maintenanceInFlight">
        <wait max="900s">
          <interrupt>
            <conditions><event_object_signalled object="$ship" param="'GT_Maintenance_Complete'"/></conditions>
          </interrupt>
        </wait>
      </do_if>
      <do_elseif value="global.$GT_MaintenanceOrders? and global.$GT_MaintenanceOrders.{$ship}?">
        <remove_value name="global.$GT_MaintenanceOrders.{$ship}"/>
      </do_elseif>
      <do_if value="this.$maintenance_transition?"><remove_value name="this.$maintenance_transition"/></do_if>
      <return value="true"/>
    </actions>
  </attention>
</aiscript>
