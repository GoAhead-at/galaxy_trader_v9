<?xml version="1.0" encoding="utf-8"?>
<mdscript name="GT_Fleet_Coordination" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../stock_game/X4 Foundations/libraries/md.xsd">
  <cues>
    <!-- Update Ship Statistics -->
    <library name="UpdateShipStats" purpose="run_actions">
      <params>
        <param name="ship" comment="Ship to update"/>
        <param name="profit" default="0" comment="Profit to add"/>
        <param name="tradesCompleted" default="0" comment="Trades to add"/>
      </params>
      <actions>
        <!-- Ensure ship is registered -->
        <do_if value="not global.$GT_Ships.{$ship}?">
          <set_value name="global.$GT_Ships.{$ship}" exact="table[
            $Pilot = $ship.pilot,
            $LastUpdate = player.age,
            $TotalProfit = 0,
            $TradesCompleted = 0,
            $ThreatReports = 0,
            $LastThreatTime = 0,
            $RegistrationTime = player.age
          ]"/>
        </do_if>
        
        <!-- Initialize ship statistics if missing (for ships registered before these fields existed) -->
        <do_if value="not global.$GT_Ships.{$ship}.$TotalProfit?">
          <set_value name="global.$GT_Ships.{$ship}.$TotalProfit" exact="0"/>
        </do_if>
        <do_if value="not global.$GT_Ships.{$ship}.$TradesCompleted?">
          <set_value name="global.$GT_Ships.{$ship}.$TradesCompleted" exact="0"/>
        </do_if>
        
        <!-- Update ship statistics -->
        <set_value name="global.$GT_Ships.{$ship}.$TotalProfit" exact="global.$GT_Ships.{$ship}.$TotalProfit + $profit"/>
        <set_value name="global.$GT_Ships.{$ship}.$TradesCompleted" exact="global.$GT_Ships.{$ship}.$TradesCompleted + $tradesCompleted"/>
        <set_value name="global.$GT_Ships.{$ship}.$LastUpdate" exact="player.age"/>
        
        <!-- Also update pilot statistics (so profit follows pilot across ships) -->
        <do_if value="@$ship.pilot and global.$GT_Pilots.{$ship.pilot}?">
          <set_value name="$pilot" exact="$ship.pilot"/>
          
          <!-- Initialize pilot profit if not set -->
          <do_if value="not global.$GT_Pilots.{$pilot}.$TotalProfit?">
            <set_value name="global.$GT_Pilots.{$pilot}.$TotalProfit" exact="0"/>
          </do_if>
          
          <!-- Update pilot profit and trade count -->
          <set_value name="global.$GT_Pilots.{$pilot}.$TotalProfit" exact="global.$GT_Pilots.{$pilot}.$TotalProfit + $profit"/>
          <set_value name="global.$GT_Pilots.{$pilot}.$TotalTrades" exact="global.$GT_Pilots.{$pilot}.$TotalTrades + $tradesCompleted"/>
          
          <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
            <debug_text text="'[GT-FleetCoord] Updated pilot ' + $pilot.name + ': +' + ($profit / 100) + ' Cr (Total: ' + (global.$GT_Pilots.{$pilot}.$TotalProfit / 100) + ' Cr, Trades: ' + global.$GT_Pilots.{$pilot}.$TotalTrades + ')'" chance="100"/>
          </do_if>
        </do_if>
        
        <set_value name="this.$result" exact="global.$GT_Ships.{$ship}"/>
      </actions>
    </library>
  </cues>
</mdscript>
