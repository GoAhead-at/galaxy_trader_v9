<?xml version="1.0" encoding="utf-8"?>
<!-- lib.gt.mk4.free.supplier — one rule for MK4 free delivery / free supplier.
     No <wait>: called during SELL/BUY create_trade_order queueing. A yield there lets
     already-queued sell TradePerform run before buys are queued → ERR_NOTHING_TO_SELL.

     PlayerFreeSupplier: buyfree hint OR player-owned buy station / buy-offer owner /
       stamped $PlayerFreeSupplier on the trade.
     FreeDelivery: player-owned customer OR buyfree on customer sell-offer OR PlayerFreeSupplier.
       Vanilla transfers wares between two player-owned parties for free (the engine reports
       buyfree.{ship}=1 on those offers), so a player station / build storage never pays for a
       delivery - the NPC purchase is billed to the player account instead.
     Sell-only (clearance) has no supplier leg at all - lib.gt.search.sell_only stamps
     $BuyStation = the trading ship as a placeholder, which would otherwise read as a
     player-owned supplier and hand the cargo to the customer for free. -->
<aiscript name="lib.gt.mk4.free.supplier" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../stock_game/X4 Foundations/libraries/aiscripts.xsd" version="1">
  <params>
    <param name="buyStation" default="null"/>
    <param name="buyOffer" default="null"/>
    <param name="sellStation" default="null"/>
    <param name="sellOffer" default="null"/>
    <param name="trade" default="null" comment="Optional trade table; reads $BuyStation/$BuyOffer/$PlayerFreeSupplier"/>
    <param name="playerFreeSupplierHint" default="false" comment="Explicit stamp when trade table is unavailable"/>
    <param name="isSellOnly" default="false" comment="Clearance leg: ship sells its own cargo, there is no supplier"/>
  </params>
  <attention min="unknown">
    <actions>
      <set_value name="$bs" exact="$buyStation"/>
      <set_value name="$bo" exact="$buyOffer"/>
      <set_value name="$ss" exact="$sellStation"/>
      <set_value name="$so" exact="$sellOffer"/>
      <set_value name="$hint" exact="if $playerFreeSupplierHint? then $playerFreeSupplierHint else false"/>
      <set_value name="$sellOnly" exact="if $isSellOnly? then $isSellOnly else false"/>

      <do_if value="$trade? and $trade != null">
        <do_if value="(not $bs? or not @$bs.exists) and $trade.$BuyStation? and @$trade.$BuyStation.exists">
          <set_value name="$bs" exact="$trade.$BuyStation"/>
        </do_if>
        <do_if value="(not $bo? or not @$bo.exists) and $trade.$BuyOffer?">
          <set_value name="$bo" exact="$trade.$BuyOffer"/>
        </do_if>
        <do_if value="(not $ss? or not @$ss.exists) and $trade.$SellStation? and @$trade.$SellStation.exists">
          <set_value name="$ss" exact="$trade.$SellStation"/>
        </do_if>
        <do_if value="(not $so? or not @$so.exists) and $trade.$SellOffer?">
          <set_value name="$so" exact="$trade.$SellOffer"/>
        </do_if>
        <do_if value="$trade.$PlayerFreeSupplier? and $trade.$PlayerFreeSupplier">
          <set_value name="$hint" exact="true"/>
        </do_if>
        <do_if value="$trade.$IsSellOnly? and $trade.$IsSellOnly">
          <set_value name="$sellOnly" exact="true"/>
        </do_if>
      </do_if>

      <set_value name="$playerFreeSupplier" exact="false"/>
      <do_if value="not $sellOnly">
        <do_if value="$hint">
          <set_value name="$playerFreeSupplier" exact="true"/>
        </do_if>
        <do_elseif value="$bs? and @$bs.exists and @$bs.isplayerowned">
          <set_value name="$playerFreeSupplier" exact="true"/>
        </do_elseif>
        <do_elseif value="$bo? and @$bo.exists and $bo.owner? and @$bo.owner.exists and @$bo.owner.isplayerowned">
          <set_value name="$playerFreeSupplier" exact="true"/>
        </do_elseif>
        <do_elseif value="$bo? and @$bo.exists and $bo.seller? and @$bo.seller.exists and @$bo.seller.isplayerowned">
          <set_value name="$playerFreeSupplier" exact="true"/>
        </do_elseif>
      </do_if>

      <!-- Delivery customer: live sell-offer buyer/owner, else the stamped sell station
           (build storage offers frequently have no live buyer/owner on the offer ref). -->
      <set_value name="$customer" exact="null"/>
      <do_if value="$so? and @$so.exists and $so.buyer? and @$so.buyer.exists">
        <set_value name="$customer" exact="@$so.buyer"/>
      </do_if>
      <do_if value="$customer == null and $so? and @$so.exists and $so.owner? and @$so.owner.exists">
        <set_value name="$customer" exact="@$so.owner"/>
      </do_if>
      <do_if value="$customer == null and $ss? and @$ss.exists">
        <set_value name="$customer" exact="$ss"/>
      </do_if>

      <set_value name="$freeDelivery" exact="false"/>
      <do_if value="$customer != null and @$customer.isplayerowned">
        <set_value name="$freeDelivery" exact="true"/>
      </do_if>
      <do_elseif value="$customer != null and @$customer.isclass.buildstorage and $customer.base? and @$customer.base.exists and @$customer.base.isplayerowned">
        <set_value name="$freeDelivery" exact="true"/>
      </do_elseif>
      <do_elseif value="$so? and @$so.exists and @$so.buyfree">
        <set_value name="$freeDelivery" exact="true"/>
      </do_elseif>
      <do_elseif value="$so? and @$so.exists and $ss? and @$ss.exists and @$so.buyfree.{$ss}">
        <set_value name="$freeDelivery" exact="true"/>
      </do_elseif>
      <do_elseif value="$playerFreeSupplier">
        <set_value name="$freeDelivery" exact="true"/>
      </do_elseif>

      <return value="table[
        $PlayerFreeSupplier = $playerFreeSupplier,
        $FreeDelivery = $freeDelivery
      ]"/>
    </actions>
  </attention>
</aiscript>
