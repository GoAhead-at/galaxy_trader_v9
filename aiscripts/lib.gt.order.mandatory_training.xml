<?xml version="1.0" encoding="utf-8"?>
<aiscript name="lib.gt.order.mandatory_training" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../stock_game/X4 Foundations/libraries/aiscripts.xsd" version="1">
  <!--
    Shared MK3/MK4 handle_mandatory_training gate + dispatch (simplification Phase 3).
    No wait/interrupt here - caller owns the 10s wait and resume graph.
    Returns table[$Next = 'check_maintenance'|'wait'].
    Instant-return (no wait) so caller locals survive.
  -->
  <params>
    <param name="ship" default="this.ship"/>
    <param name="autotraining" default="true"/>
    <param name="logPrefix" default="'GT-AI'"/>
  </params>
  <attention min="unknown">
    <actions>
      <set_value name="$pilotNameForDebug" exact="'No Pilot'"/>
      <do_if value="$ship.pilot? and @$ship.pilot.exists">
        <set_value name="$pilotNameForDebug" exact="$ship.pilot.name"/>
      </do_if>

      <!-- Check if ship has an active DockAndTrain order -->
      <set_value name="$hasActiveTrainingOrder" exact="false"/>
      <do_if value="$ship.orders.count gt 0">
        <do_all exact="$ship.orders.count" counter="$i">
          <do_if value="$ship.orders.{$i}.id == 'DockAndTrain'">
            <set_value name="$hasActiveTrainingOrder" exact="true"/>
            <break/>
          </do_if>
        </do_all>
      </do_if>

      <!-- ENHANCED LOGIC: Auto-restart training if it was previously interrupted.
           Conditions for starting/restarting training:
           1. Auto-training is enabled
           2. Ship has a pilot with GT pilot data
           3. Either: training not in progress OR no active training order (interrupted) -->
      <set_value name="$manualTrainingRequested" exact="false"/>
      <do_if value="$ship.pilot and global.$GT_Pilots.{$ship.pilot}? and global.$GT_Pilots.{$ship.pilot}.$ManualTrainingRequested? and global.$GT_Pilots.{$ship.pilot}.$ManualTrainingRequested">
        <set_value name="$manualTrainingRequested" exact="true"/>
      </do_if>
      <set_value name="$academyEnrollmentPending" exact="false"/>
      <do_if value="$ship.pilot and global.$GT_Pilots.{$ship.pilot}? and global.$GT_Pilots.{$ship.pilot}.$AcademyEnrollment?">
        <set_value name="$academyEnrollmentPending" exact="true"/>
      </do_if>
      <do_if value="($autotraining or $manualTrainingRequested or $academyEnrollmentPending) and $ship.pilot and global.$GT_Pilots.{$ship.pilot}">
        <set_value name="$shouldStartTraining" exact="false"/>
        <set_value name="$mdTrainingInProgress" exact="global.$GT_Pilots.{$ship.pilot}.$TrainingState? and global.$GT_Pilots.{$ship.pilot}.$TrainingState == 'training_in_progress'"/>

        <!-- Case 0: Active DockAndTrain or MD timer (save/load) - wait, do not re-dispatch -->
        <do_if value="$hasActiveTrainingOrder or $mdTrainingInProgress">
          <do_if value="not this.$training_in_progress?">
            <set_value name="this.$training_in_progress" exact="true"/>
            <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
              <debug_text text="'[' + $logPrefix + '] ' + $ship.idcode + ': Restored in-flight training session after save/load (DockAndTrain=' + $hasActiveTrainingOrder + ', MD timer=' + $mdTrainingInProgress + ')'" chance="100"/>
            </do_if>
          </do_if>
        </do_if>
        <!-- Case 1: Training not currently in progress -->
        <do_elseif value="not this.$training_in_progress?">
          <set_value name="$shouldStartTraining" exact="true"/>
          <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
            <debug_text text="'[' + $logPrefix + '] ' + $ship.idcode + ': Training not in progress - can start training'" chance="100"/>
          </do_if>
        </do_elseif>
        <!-- Case 2: Training was marked as in progress but no active training order (interrupted) -->
        <do_elseif value="this.$training_in_progress? and not $hasActiveTrainingOrder">
          <set_value name="$shouldStartTraining" exact="true"/>
          <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
            <debug_text text="'[' + $logPrefix + '] ' + $ship.idcode + ': TRAINING INTERRUPTED: Previous training was aborted - restarting automatically'" chance="100"/>
          </do_if>
          <remove_value name="this.$training_in_progress"/>
        </do_elseif>

        <do_if value="$shouldStartTraining">
          <!-- Inline training gate evaluation (AI scripts cannot call MD libraries) -->
          <set_value name="$hardForceTraining" exact="true"/>
          <do_if value="global.$GT_GlobalSettings? and global.$GT_GlobalSettings.$XP? and global.$GT_GlobalSettings.$XP.$HardForceTraining?">
            <set_value name="$hardForceTraining" exact="global.$GT_GlobalSettings.$XP.$HardForceTraining"/>
          </do_if>
          <set_value name="$blockedLevel" exact="1"/>
          <do_if value="global.$GT_Pilots.{$ship.pilot}.$BlockedLevel? and global.$GT_Pilots.{$ship.pilot}.$BlockedLevel gt 0">
            <set_value name="$blockedLevel" exact="global.$GT_Pilots.{$ship.pilot}.$BlockedLevel"/>
          </do_if>
          <set_value name="$mustTrainNow" exact="if (global.$GT_GlobalSettings? and global.$GT_GlobalSettings.$XP? and global.$GT_GlobalSettings.$XP.$UseVanillaXPOnly? and global.$GT_GlobalSettings.$XP.$UseVanillaXPOnly) then false else (global.$GT_Pilots.{$ship.pilot}.$XPBlocked? or global.$GT_Pilots.{$ship.pilot}.$PausedWithTrainingNeeded? or ($hardForceTraining and $blockedLevel gt 1))"/>
          <set_value name="$shouldRetryTraining" exact="if (global.$GT_GlobalSettings? and global.$GT_GlobalSettings.$XP? and global.$GT_GlobalSettings.$XP.$UseVanillaXPOnly? and global.$GT_GlobalSettings.$XP.$UseVanillaXPOnly) then false else ($mustTrainNow or ((not $hardForceTraining) and $blockedLevel gt 1) or ($manualTrainingRequested and $blockedLevel gt 1))"/>
          <set_value name="$trainingGateReason" exact="'none'"/>
          <do_if value="global.$GT_Pilots.{$ship.pilot}.$PausedWithTrainingNeeded?">
            <set_value name="$trainingGateReason" exact="'paused_training_needed'"/>
          </do_if>
          <do_elseif value="global.$GT_Pilots.{$ship.pilot}.$XPBlocked?">
            <set_value name="$trainingGateReason" exact="'xp_blocked'"/>
          </do_elseif>
          <do_elseif value="$hardForceTraining and $blockedLevel gt 1">
            <set_value name="$trainingGateReason" exact="'hard_force_blocked_level'"/>
          </do_elseif>
          <do_elseif value="$blockedLevel gt 1">
            <set_value name="$trainingGateReason" exact="'soft_force_blocked_level'"/>
          </do_elseif>

          <do_if value="$shouldRetryTraining">
            <do_if value="not (global.$GT_Pilots.{$ship.pilot}.$BlockedLevel? and global.$GT_Pilots.{$ship.pilot}.$BlockedLevel gt 0)">
              <do_if value="global.$GT_Pilots.{$ship.pilot}.$XP?">
                <set_value name="$currentXP" exact="global.$GT_Pilots.{$ship.pilot}.$XP"/>
                <do_all exact="15" counter="$skillLevel">
                  <do_if value="$currentXP ge global.$GT_Config.$XP.$SkillThresholds.{$skillLevel}">
                    <set_value name="$blockedLevel" exact="$skillLevel"/>
                  </do_if>
                </do_all>
              </do_if>
            </do_if>

            <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
              <debug_text text="'[' + $logPrefix + '] ' + $ship.idcode + ': 🎓 Initiating mandatory training for pilot ' + $pilotNameForDebug + ' (Level ' + $blockedLevel + ', reason=' + $trainingGateReason + ', hardforce=' + $hardForceTraining + ')'" chance="100"/>
            </do_if>

            <!-- Respect $NextTrainingRetryAt for all training modes (dock-fail / no-station / funds). -->
            <set_value name="$retryReady" exact="true"/>
            <do_if value="global.$GT_Pilots.{$ship.pilot}.$NextTrainingRetryAt? and player.age lt global.$GT_Pilots.{$ship.pilot}.$NextTrainingRetryAt">
              <set_value name="$retryReady" exact="false"/>
            </do_if>

            <do_if value="$retryReady">
              <signal_objects object="player.galaxy" param="'GT_Training_Needed'" param2="table[
                $Ship = $ship,
                $Pilot = $ship.pilot,
                $RequiredLevel = $blockedLevel
              ]"/>

              <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
                <debug_text text="'[' + $logPrefix + '] ' + $ship.idcode + ': Training signal sent to MD system for pilot ' + $pilotNameForDebug" chance="100"/>
              </do_if>
            </do_if>
            <do_else>
              <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
                <set_value name="$retryRemaining" exact="(global.$GT_Pilots.{$ship.pilot}.$NextTrainingRetryAt - player.age) / 1s"/>
                <debug_text text="'[' + $logPrefix + '] ' + $ship.idcode + ': Training retry backoff active (' + $retryRemaining + 's remaining)'" chance="100"/>
              </do_if>
            </do_else>
          </do_if>
          <do_else>
            <!-- Training is not mandatory under current gate policy -->
            <set_value name="$blockedLevelForDebug" exact="'none'"/>
            <do_if value="global.$GT_Pilots.{$ship.pilot}.$BlockedLevel?">
              <set_value name="$blockedLevelForDebug" exact="global.$GT_Pilots.{$ship.pilot}.$BlockedLevel"/>
            </do_if>
            <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
              <debug_text text="'[' + $logPrefix + '] ' + $ship.idcode + ': Training gate allows trading in mandatory handler (reason=' + $trainingGateReason + ', blockedLevel=' + $blockedLevelForDebug + ', hardforce=' + $hardForceTraining + ')'" chance="100"/>
            </do_if>
            <return value="table[$Next = 'check_maintenance']"/>
          </do_else>
        </do_if>
        <do_else>
          <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
            <debug_text text="'[' + $logPrefix + '] ' + $ship.idcode + ': ⏳ Training already in progress (active order: ' + $hasActiveTrainingOrder + ') - waiting'" chance="100"/>
          </do_if>
        </do_else>
      </do_if>
      <do_else>
        <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
          <debug_text text="'[' + $logPrefix + '] ' + $ship.idcode + ': Auto-training disabled or no pilot data - waiting'" chance="100"/>
        </do_if>
      </do_else>

      <return value="table[$Next = 'wait']"/>
    </actions>
  </attention>
</aiscript>
