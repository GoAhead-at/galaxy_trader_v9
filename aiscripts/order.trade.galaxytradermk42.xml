<?xml version="1.0" encoding="utf-8"?>
<!-- TODO(MK4-2 migrate): DELETE this entire file once all players have loaded a build that
     renamed GalaxyTraderMK4Supply2 -> GalaxyTraderMK4Supply (no saves left with the old order id).
     Also strip Supply2 from $GT_ProtectedOrderIDs, RemapMK4Supply2InheritOrderIdOnLoad, and
     Assist inherit/abort Supply2 branches (search GalaxyTraderMK4Supply2 / galaxytradermk42).
     Migration stub: keeps save-import of the old GalaxyTraderMK4Supply2 default order alive,
     then immediately replaces it with GalaxyTraderMK4Supply (preserves station assignment / params).
     MUST keep aiscript name order.trade.galaxytradermk42: mid-flight save contexts bind by script
     name. Renaming to gt_mk42_migrate left 73 import failures and an Assist cleanup storm
     (commanders stuck on broken Supply2 while subordinates abort/re-inherit).
     Hidden from order UI via category=internal. Do not assign manually. -->
<aiscript name="order.trade.galaxytradermk42" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../stock_game/X4 Foundations/libraries/aiscripts.xsd" version="2">
  <order id="GalaxyTraderMK4Supply2" name="{77000, 10007}" description="{77000, 10107}" category="internal" allowinloop="false" canplayercancel="true">
    <params>
      <!-- MK4 Galaxy-Supply - OPEN_GALAXYTRADER_MK4_SUPPLY_ORDER.md -->
      <param name="home" default="this.sector" type="object" text="{77000,1002}" comment="{77000,1020}">
        <input_param name="class" value="[class.sector,class.station]"/>
      </param>
      <param name="assignHome" default="true" type="bool" text="{77000,1085}" comment="{77000,1111}"/>
      <param name="jumpDistanceCoverage" default="1" type="number" text="{77000,1086}" comment="{77000,1088}">
        <input_param name="startvalue" value="1"/>
        <input_param name="min" value="1"/>
        <input_param name="max" value="[if (global.$GT_GlobalSettings? and global.$GT_GlobalSettings.$XP? and global.$GT_GlobalSettings.$XP.$UseVanillaXPOnly? and global.$GT_GlobalSettings.$XP.$UseVanillaXPOnly) then 25 else (if (this.ship.pilot? and global.$GT_Pilots? and global.$GT_Pilots.{this.ship.pilot}? and global.$GT_Pilots.{this.ship.pilot}.$Level?) then (if global.$GT_Pilots.{this.ship.pilot}.$Level le 2 then 1 else if global.$GT_Pilots.{this.ship.pilot}.$Level le 5 then 3 else if global.$GT_Pilots.{this.ship.pilot}.$Level le 8 then 5 else if global.$GT_Pilots.{this.ship.pilot}.$Level le 11 then 10 else if global.$GT_Pilots.{this.ship.pilot}.$Level le 13 then 15 else 25) else 1), 1].max"/>
        <input_param name="step" value="1"/>
      </param>
      <param name="jumpDistanceBuy" default="1" type="number" text="{77000,1021}" comment="{77000,1087}">
        <input_param name="startvalue" value="1"/>
        <input_param name="min" value="1"/>
        <input_param name="max" value="[if (global.$GT_GlobalSettings? and global.$GT_GlobalSettings.$XP? and global.$GT_GlobalSettings.$XP.$UseVanillaXPOnly? and global.$GT_GlobalSettings.$XP.$UseVanillaXPOnly) then 25 else (if (this.ship.pilot? and global.$GT_Pilots? and global.$GT_Pilots.{this.ship.pilot}? and global.$GT_Pilots.{this.ship.pilot}.$Level?) then (if global.$GT_Pilots.{this.ship.pilot}.$Level le 2 then 1 else if global.$GT_Pilots.{this.ship.pilot}.$Level le 5 then 3 else if global.$GT_Pilots.{this.ship.pilot}.$Level le 8 then 5 else if global.$GT_Pilots.{this.ship.pilot}.$Level le 11 then 10 else if global.$GT_Pilots.{this.ship.pilot}.$Level le 13 then 15 else 25) else 1), 1].max"/>
        <input_param name="step" value="1"/>
      </param>
      <param name="serveHomeOnly" default="false" type="bool" text="{77000,1072}" comment="{77000,1089}"/>
      <param name="buyFromPlayer" default="5" type="number" text="{77000,1073}" comment="{77000,1112}">
        <input_param name="startvalue" value="5"/>
        <input_param name="min" value="0"/>
        <input_param name="max" value="10"/>
        <input_param name="step" value="1"/>
      </param>
      <param name="buyFromFaction" default="5" type="number" text="{77000,1074}" comment="{77000,1113}">
        <input_param name="startvalue" value="5"/>
        <input_param name="min" value="0"/>
        <input_param name="max" value="10"/>
        <input_param name="step" value="1"/>
      </param>
      <param name="priorityBuildstorage" default="10" type="number" text="{77000,11001}" comment="{77000,11005}">
        <input_param name="startvalue" value="10"/>
        <input_param name="min" value="0"/>
        <input_param name="max" value="10"/>
        <input_param name="step" value="1"/>
      </param>
      <param name="priorityStations" default="8" type="number" text="{77000,11002}" comment="{77000,11005}">
        <input_param name="startvalue" value="8"/>
        <input_param name="min" value="0"/>
        <input_param name="max" value="10"/>
        <input_param name="step" value="1"/>
      </param>
      <param name="priorityAux" default="0" type="number" text="{77000,11003}" comment="{77000,11005}">
        <input_param name="startvalue" value="0"/>
        <input_param name="min" value="0"/>
        <input_param name="max" value="10"/>
        <input_param name="step" value="1"/>
      </param>
      <param name="allowResources" default="true" type="bool" text="{77000,1076}" comment="{77000,32116}"/>
      <param name="allowIntermediates" default="true" type="bool" text="{77000,1077}" comment="{77000,32117}"/>
      <param name="allowTradewares" default="true" type="bool" text="{77000,1078}" comment="{77000,1090}"/>
      <param name="autowares" default="true" type="bool" text="{77000,1015}" comment="{77000,1023}"/>
      <param name="warebasket" default="[]" type="list" text="{77000,1069}" comment="{77000,1024}">
        <input_param name="type" value="'ware'"/>
        <input_param name="cancarry" value="this.ship"/>
      </param>
      <param name="priorityscoremultiplier" default="1" type="number" text="{77000,11007}" comment="{77000,11006}">
        <input_param name="startvalue" value="1"/>
        <input_param name="min" value="1"/>
        <input_param name="max" value="10"/>
        <input_param name="step" value="1"/>
      </param>
      <param name="prioritywares" default="[]" type="list" text="{77000,1064}" comment="{77000,1066}">
        <input_param name="type" value="'ware'"/>
        <input_param name="cancarry" value="this.ship"/>
      </param>
      <param name="maxTrades" default="3" type="number" text="{77000,1080}" comment="{77000,1114}">
        <input_param name="min" value="1"/>
        <input_param name="max" value="3"/>
        <input_param name="step" value="1"/>
      </param>
      <param name="backtrackTolerance" default="1" type="number" text="{77000,1081}" comment="{77000,30115}">
        <input_param name="min" value="0"/>
        <input_param name="max" value="5"/>
        <input_param name="step" value="1"/>
      </param>
      <param name="useMinCargoThreshold" default="false" type="bool" text="{77000,1115}" comment="{77000,1116}"/>
      <param name="minCargoUsed" default="80" type="number" text="{77000,1082}" comment="{77000,1117}">
        <input_param name="min" value="10"/>
        <input_param name="max" value="100"/>
        <input_param name="step" value="5"/>
      </param>
      <param name="allowSmallDestinationFills" default="true" type="bool" text="{77000,1100}" comment="{77000,1101}"/>
      <param name="minstorage" default="100" type="number" text="{77000, 30022}" comment="{77000, 30122}">
        <input_param name="startvalue" value="100"/>
        <input_param name="min" value="5"/>
        <input_param name="max" value="100"/>
        <input_param name="step" value="5"/>
      </param>
      <param name="allowillegal" default="false" type="bool" text="{77000,1011}" comment="{77000,1025}"/>
      <param name="enforceRouteIllegalLegality" default="false" type="bool" text="{77000,1070}" comment="{77000,1071}"/>
      <param name="ignoretraderules" default="false" type="bool" text="{77000,1058}" comment="{77000,1059}"/>
      <param name="ignoremk1supply" default="true" type="bool" text="{77000,1060}" comment="{77000,1061}"/>
      <param name="logbookentries" default="true" type="bool" text="{77000,1012}" comment="{77000,1041}"/>
      <param name="idleParking" default="false" type="bool" text="{77000,1096}" comment="{77000,1097}"/>
      <param name="autoJumpDistanceByLevel" default="false" type="bool" text="{77000,1098}" comment="{77000,1099}"/>
      <param name="sectorwhitelist" default="[]" type="list" text="{77000,1052}" comment="{77000,1053}">
        <input_param name="type" value="'object'"/>
        <input_param name="class" value="[class.sector]"/>
      </param>
      <param name="stationwhitelist" default="[]" type="list" text="{77000,11015}" comment="{77000,11016}">
        <input_param name="type" value="'object'"/>
        <input_param name="class" value="[class.station]"/>
      </param>
      <param name="stationblacklist" default="[]" type="list" text="{77000,11017}" comment="{77000,11018}">
        <input_param name="type" value="'object'"/>
        <input_param name="class" value="[class.station]"/>
      </param>
      <param name="distancepenalty" default="50" type="number" text="{77000,1016}" comment="{77000,1110}">
        <input_param name="min" value="0"/>
        <input_param name="max" value="100"/>
        <input_param name="step" value="5"/>
      </param>
      <param name="fleetcoordination" default="true" type="bool" text="{77000,1018}" advanced="true" comment="{77000,1029}"/>
      <param name="marketupdatefreq" default="60s" type="time" text="{77000,1050}" advanced="true" comment="{77000,1034}">
        <input_param name="min" value="30s"/>
        <input_param name="max" value="300s"/>
        <input_param name="step" value="30s"/>
      </param>
      <param name="debuglevel" default="1" type="number" text="{77000,20521}" advanced="true" comment="{77000,1035}">
        <input_param name="min" value="0"/>
        <input_param name="max" value="2"/>
        <input_param name="step" value="1"/>
      </param>
      <param name="tradeeval" default="false" type="bool" text="{77000,1051}" advanced="true" comment="{77000,1040}"/>
    </params>
    <requires>
      <match shiptype="shiptype.lasertower" negate="true"/>
    </requires>
  </order>
  <patch sinceversion="1">
    <debug_text text="'[GalaxyTrader MK4] Supply2 migrate stub rebound as order.trade.galaxytradermk42 (save mid-flight bind)'" chance="100" filter="savegame"/>
  </patch>

  <attention min="unknown">
    <actions>
      <!-- Older Supply2 saves may lack params added later; undeclared $param aborts create_order
           and leaves the commander with no default order (Assist orphan/cleanup storm). -->
      <do_if value="not $home? or @$home == null or not @$home.exists">
        <set_value name="$home" exact="this.ship.sector"/>
      </do_if>
      <do_if value="not $assignHome?"><set_value name="$assignHome" exact="true"/></do_if>
      <do_if value="not $jumpDistanceCoverage?"><set_value name="$jumpDistanceCoverage" exact="1"/></do_if>
      <do_if value="not $jumpDistanceBuy?"><set_value name="$jumpDistanceBuy" exact="1"/></do_if>
      <do_if value="not $serveHomeOnly?"><set_value name="$serveHomeOnly" exact="false"/></do_if>
      <do_if value="not $buyFromPlayer?"><set_value name="$buyFromPlayer" exact="5"/></do_if>
      <do_if value="not $buyFromFaction?"><set_value name="$buyFromFaction" exact="5"/></do_if>
      <do_if value="not $priorityBuildstorage?"><set_value name="$priorityBuildstorage" exact="10"/></do_if>
      <do_if value="not $priorityStations?"><set_value name="$priorityStations" exact="8"/></do_if>
      <do_if value="not $priorityAux?"><set_value name="$priorityAux" exact="0"/></do_if>
      <do_if value="not $allowResources?"><set_value name="$allowResources" exact="true"/></do_if>
      <do_if value="not $allowIntermediates?"><set_value name="$allowIntermediates" exact="true"/></do_if>
      <do_if value="not $allowTradewares?"><set_value name="$allowTradewares" exact="true"/></do_if>
      <do_if value="not $autowares?"><set_value name="$autowares" exact="true"/></do_if>
      <do_if value="not $warebasket? or @$warebasket == null"><set_value name="$warebasket" exact="[]"/></do_if>
      <do_if value="not $priorityscoremultiplier?"><set_value name="$priorityscoremultiplier" exact="1"/></do_if>
      <do_if value="not $prioritywares? or @$prioritywares == null"><set_value name="$prioritywares" exact="[]"/></do_if>
      <do_if value="not $maxTrades?"><set_value name="$maxTrades" exact="3"/></do_if>
      <do_if value="not $backtrackTolerance?"><set_value name="$backtrackTolerance" exact="1"/></do_if>
      <do_if value="not $useMinCargoThreshold?"><set_value name="$useMinCargoThreshold" exact="false"/></do_if>
      <do_if value="not $minCargoUsed?"><set_value name="$minCargoUsed" exact="80"/></do_if>
      <do_if value="not $allowSmallDestinationFills?"><set_value name="$allowSmallDestinationFills" exact="true"/></do_if>
      <do_if value="not $minstorage?"><set_value name="$minstorage" exact="100"/></do_if>
      <do_if value="not $allowillegal?"><set_value name="$allowillegal" exact="false"/></do_if>
      <do_if value="not $enforceRouteIllegalLegality?"><set_value name="$enforceRouteIllegalLegality" exact="false"/></do_if>
      <do_if value="not $ignoretraderules?"><set_value name="$ignoretraderules" exact="false"/></do_if>
      <do_if value="not $ignoremk1supply?"><set_value name="$ignoremk1supply" exact="true"/></do_if>
      <do_if value="not $logbookentries?"><set_value name="$logbookentries" exact="true"/></do_if>
      <do_if value="not $idleParking?"><set_value name="$idleParking" exact="false"/></do_if>
      <do_if value="not $autoJumpDistanceByLevel?"><set_value name="$autoJumpDistanceByLevel" exact="false"/></do_if>
      <do_if value="not $sectorwhitelist? or @$sectorwhitelist == null"><set_value name="$sectorwhitelist" exact="[]"/></do_if>
      <do_if value="not $stationwhitelist? or @$stationwhitelist == null"><set_value name="$stationwhitelist" exact="[]"/></do_if>
      <do_if value="not $stationblacklist? or @$stationblacklist == null"><set_value name="$stationblacklist" exact="[]"/></do_if>
      <do_if value="not $distancepenalty?"><set_value name="$distancepenalty" exact="50"/></do_if>
      <do_if value="not $fleetcoordination?"><set_value name="$fleetcoordination" exact="true"/></do_if>
      <do_if value="not $marketupdatefreq?"><set_value name="$marketupdatefreq" exact="60s"/></do_if>
      <do_if value="not $debuglevel?"><set_value name="$debuglevel" exact="1"/></do_if>
      <do_if value="not $tradeeval?"><set_value name="$tradeeval" exact="false"/></do_if>

      <debug_text text="'[GalaxyTrader MK4] Migrating ' + this.ship.knownname + ' from GalaxyTraderMK4Supply2 to GalaxyTraderMK4Supply'" chance="100"/>
      <!-- default only: engine rejects default+immediate together (immediate is ignored and can
           leave orders.base reporting "returned but no new order"). Mid-flight saves with
           Invalid blocking action never reach this attention - MD MigrateMK4Supply2OrdersOnLoad
           covers those. -->
      <create_order id="'GalaxyTraderMK4Supply'" object="this.ship" default="true">
          <param name="home" value="$home"/>
          <param name="assignHome" value="$assignHome"/>
          <param name="jumpDistanceCoverage" value="$jumpDistanceCoverage"/>
          <param name="jumpDistanceBuy" value="$jumpDistanceBuy"/>
          <param name="serveHomeOnly" value="$serveHomeOnly"/>
          <param name="buyFromPlayer" value="$buyFromPlayer"/>
          <param name="buyFromFaction" value="$buyFromFaction"/>
          <param name="priorityBuildstorage" value="$priorityBuildstorage"/>
          <param name="priorityStations" value="$priorityStations"/>
          <param name="priorityAux" value="$priorityAux"/>
          <param name="allowResources" value="$allowResources"/>
          <param name="allowIntermediates" value="$allowIntermediates"/>
          <param name="allowTradewares" value="$allowTradewares"/>
          <param name="autowares" value="$autowares"/>
          <param name="warebasket" value="$warebasket"/>
          <param name="priorityscoremultiplier" value="$priorityscoremultiplier"/>
          <param name="prioritywares" value="$prioritywares"/>
          <param name="maxTrades" value="$maxTrades"/>
          <param name="backtrackTolerance" value="$backtrackTolerance"/>
          <param name="useMinCargoThreshold" value="$useMinCargoThreshold"/>
          <param name="minCargoUsed" value="$minCargoUsed"/>
          <param name="allowSmallDestinationFills" value="$allowSmallDestinationFills"/>
          <param name="minstorage" value="$minstorage"/>
          <param name="allowillegal" value="$allowillegal"/>
          <param name="enforceRouteIllegalLegality" value="$enforceRouteIllegalLegality"/>
          <param name="ignoretraderules" value="$ignoretraderules"/>
          <param name="ignoremk1supply" value="$ignoremk1supply"/>
          <param name="logbookentries" value="$logbookentries"/>
          <param name="idleParking" value="$idleParking"/>
          <param name="autoJumpDistanceByLevel" value="$autoJumpDistanceByLevel"/>
          <param name="sectorwhitelist" value="$sectorwhitelist"/>
          <param name="stationwhitelist" value="$stationwhitelist"/>
          <param name="stationblacklist" value="$stationblacklist"/>
          <param name="distancepenalty" value="$distancepenalty"/>
          <param name="fleetcoordination" value="$fleetcoordination"/>
          <param name="marketupdatefreq" value="$marketupdatefreq"/>
          <param name="debuglevel" value="$debuglevel"/>
          <param name="tradeeval" value="$tradeeval"/>
      </create_order>
    </actions>
  </attention>
</aiscript>
