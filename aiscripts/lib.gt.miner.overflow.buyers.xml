<?xml version="1.0" encoding="utf-8"?>
<aiscript name="lib.gt.miner.overflow.buyers" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../stock_game/X4 Foundations/libraries/aiscripts.xsd" version="1">
  <!--
    Direct buy-offer probe for automatic overflow buyers.

    Home and Additional Targets are queried by the caller. This library asks every other
    player station in the already-built sell spaces, with the same buyer= + tradepartner
    query those primaries use. The sector-wide offer scan misses stations that query finds.
  -->
  <params>
    <param name="ship" default="null"/>
    <param name="sellSpaces" default="[]"/>
    <param name="wares" default="[]"/>
    <param name="excludeStations" default="[]"/>
    <param name="blockedStations" default="[]"/>
    <param name="debugchance" default="0"/>
  </params>
  <attention min="unknown">
    <actions>
      <create_list name="$offers"/>
      <do_if value="@$ship == null or not $ship.exists">
        <return value="table[$Offers = $offers]"/>
      </do_if>
      <do_if value="@$sellSpaces == null or @$wares == null">
        <return value="table[$Offers = $offers]"/>
      </do_if>
      <do_if value="$sellSpaces.count == 0 or $wares.count == 0">
        <return value="table[$Offers = $offers]"/>
      </do_if>
      <!-- Excluded and blocked stations folded into one membership table, so each candidate
           station costs one lookup instead of two list scans. -->
      <set_value name="$skipTable" exact="table[]"/>
      <do_if value="@$excludeStations != null">
        <do_all exact="$excludeStations.count" counter="$exi">
          <do_if value="@$excludeStations.{$exi}.exists">
            <set_value name="$skipTable.{$excludeStations.{$exi}}" exact="true"/>
          </do_if>
        </do_all>
      </do_if>
      <do_if value="@$blockedStations != null">
        <do_all exact="$blockedStations.count" counter="$bli">
          <do_if value="@$blockedStations.{$bli}.exists">
            <set_value name="$skipTable.{$blockedStations.{$bli}}" exact="true"/>
          </do_if>
        </do_all>
      </do_if>
      <do_all exact="$sellSpaces.count" counter="$si">
        <wait exact="1ms"/>
        <set_value name="$space" exact="$sellSpaces.{$si}"/>
        <do_if value="not $space? or not $space.exists">
          <continue/>
        </do_if>
        <find_station name="$sectorStations" space="$space" checkoperational="true" multiple="true"/>
        <do_if value="@$sectorStations == null">
          <continue/>
        </do_if>
        <do_if value="$sectorStations.count == 0">
          <continue/>
        </do_if>
        <do_all exact="$sectorStations.count" counter="$sti">
          <set_value name="$station" exact="$sectorStations.{$sti}"/>
          <do_if value="not $station? or not $station.exists or not $station.isclass.station or $station.owner != $ship.owner">
            <continue/>
          </do_if>
          <do_if value="$skipTable.{$station}?">
            <continue/>
          </do_if>
          <find_buy_offer buyer="$station" wares="$wares" tradepartner="$ship" multiple="true" result="$stationOffers"/>
          <do_if value="$stationOffers? and $stationOffers.count gt 0">
            <do_all exact="$stationOffers.count" counter="$oi">
              <set_value name="$stationOffer" exact="$stationOffers.{$oi}"/>
              <do_if value="$stationOffer? and $stationOffer.exists">
                <append_to_list name="$offers" exact="$stationOffer"/>
              </do_if>
            </do_all>
          </do_if>
        </do_all>
      </do_all>
      <debug_text text="'[GT-Miner] ' + $ship.idcode + ': overflow player-station probe offers=' + $offers.count + ' spaces=' + $sellSpaces.count" chance="$debugchance"/>
      <return value="table[$Offers = $offers]"/>
    </actions>
  </attention>
</aiscript>
