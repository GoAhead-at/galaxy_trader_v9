<?xml version="1.0" encoding="utf-8"?>
<diff>
  <!-- A full mining hold still flies to the resource. Both attention levels move before they
       test cargo, and switching to visible restarts that move after out-of-sector gathering
       already filled the bay. Stop before the move only for a Galaxy Miner ship. Vanilla
       miners keep the vanilla flight. -->

  <add sel="//aiscript[@name='order.mining.collect.ship']/init/set_command[@command='command.mining']" pos="after">
    <set_value name="$gtMinerCollect" exact="false"/>
    <do_if value="@this.assignedcontrolled.defaultorder.id == 'GalaxyMiner'">
      <set_value name="$gtMinerCollect" exact="true"/>
    </do_if>
    <do_elseif value="@this.assignedcontrolled.defaultorder.id == 'Assist' and @this.assignedcontrolled.defaultorder.$baseorder.id == 'GalaxyMiner'">
      <set_value name="$gtMinerCollect" exact="true"/>
    </do_elseif>
    <do_elseif value="this.assignedcontrolled.commander? and this.assignedcontrolled.commander.exists and this.assignedcontrolled.commander != this.assignedcontrolled and @this.assignedcontrolled.commander.defaultorder.id == 'GalaxyMiner'">
      <set_value name="$gtMinerCollect" exact="true"/>
    </do_elseif>
    <do_elseif value="this.assignedcontrolled.commander? and this.assignedcontrolled.commander.exists and @this.assignedcontrolled.commander.defaultorder.id == 'Assist' and @this.assignedcontrolled.commander.defaultorder.$baseorder.id == 'GalaxyMiner'">
      <set_value name="$gtMinerCollect" exact="true"/>
    </do_elseif>
  </add>

  <add sel="//aiscript[@name='order.mining.collect.ship']/attention[@min='visible']/actions/do_if[@value='$earlyout?']" pos="before">
    <do_if value="$gtMinerCollect?">
      <do_if value="$gtMinerCollect and not $earlyout? and $ware and this.assignedcontrolled.cargo.{$ware}.free le 0">
        <set_value name="$returnresult" exact="'cargofull'"/>
        <set_value name="$earlyout"/>
      </do_if>
    </do_if>
  </add>

  <add sel="//aiscript[@name='order.mining.collect.ship']/attention[@min='unknown']/actions/do_if[@value='$earlyout?']" pos="before">
    <do_if value="$gtMinerCollect?">
      <do_if value="$gtMinerCollect and not $earlyout? and $ware and this.assignedcontrolled.cargo.{$ware}.free le 0">
        <set_value name="$returnresult" exact="'cargofull'"/>
        <set_value name="$earlyout"/>
      </do_if>
    </do_if>
  </add>
</diff>
