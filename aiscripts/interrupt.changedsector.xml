<?xml version="1.0" encoding="utf-8"?>
<diff>
  <!-- GT: vanilla sets $changedsector_previoussector with chance="@$debugchance", but the debug_text that
       reads it rolls its own chance, so with GT debuglevel=1 (debugchance=50) it often reads an unset
       variable (Property lookup failed). Always set it, and read both sectors with @ in the debug_text.
       Two element replaces instead of a full-file override, so later vanilla changes to the rest of
       this interrupt still apply. -->
  <replace sel="//aiscript[@name='interrupt.changedsector']/interrupts/library/handler[@name='SectorChangeHandler']/actions/do_if/set_value[@name='$changedsector_previoussector']">
    <set_value name="$changedsector_previoussector" exact="event.param.sector"/>
  </replace>
  <replace sel="//aiscript[@name='interrupt.changedsector']/interrupts/library/handler[@name='SectorChangeHandler']/actions/do_if/do_if[@value='@$debugchance']/debug_text">
    <debug_text text="'%s %s %s %s from %s to %s.'.[this.ship.idcode, this.ship.knownname, this.ship, @$changedsector_eventstring, @$changedsector_previoussector.knownname, @$changedsector_newsector.knownname]" chance="@$debugchance"/>
  </replace>
</diff>
