<?xml version="1.0" encoding="utf-8"?>
<aiscript name="lib.gt.order.maintenance" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../stock_game/X4 Foundations/libraries/aiscripts.xsd" version="1">
  <!--
    Shared MK3/MK4 check_maintenance body (simplification Phase 3).
    Runs lib.gt.maintenance.execute, then consumes this.$tradeFoundViaInterrupt.
    Returns table[$Next = 'trade_found'|'start_trading']. Caller keeps resume labels.
    May wait (via maintenance.execute) - do not rely on caller locals across this call.
  -->
  <params>
    <param name="ship" default="this.ship"/>
    <param name="logPrefix" default="'GT-AI'"/>
  </params>
  <attention min="unknown">
    <actions>
      <run_script name="'lib.gt.maintenance.execute'">
        <param name="ship" value="$ship"/>
        <param name="logPrefix" value="$logPrefix"/>
      </run_script>

      <!-- CRITICAL: Check for signal that arrived during maintenance wait.
           Must happen AFTER maintenance completes but BEFORE start_trading. -->
      <do_if value="this.$tradeFoundViaInterrupt? and this.$tradeFoundViaInterrupt">
        <set_value name="this.$tradeFoundViaInterrupt" exact="false"/>
        <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
          <debug_text text="'[' + $logPrefix + '] ' + $ship.idcode + ': GT_Trade_Found signal received during maintenance wait - processing from param2 data'" chance="100"/>
        </do_if>

        <set_value name="this.$searchFailed" exact="0"/>

        <do_if value="global.$GT_NoTradeHistory? and global.$GT_NoTradeHistory.{$ship}?">
          <remove_value name="global.$GT_NoTradeHistory.{$ship}"/>
        </do_if>

        <do_if value="this.$cargoDisposalFailed?">
          <set_value name="this.$cargoDisposalFailed" exact="0"/>
        </do_if>

        <return value="table[$Next = 'trade_found']"/>
      </do_if>

      <return value="table[$Next = 'start_trading']"/>
    </actions>
  </attention>
</aiscript>
