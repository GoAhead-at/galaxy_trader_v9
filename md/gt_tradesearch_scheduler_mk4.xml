<?xml version="1.0" encoding="utf-8"?>
<mdscript name="GT_TradeSearch_Scheduler_MK4" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../stock_game/X4 Foundations/libraries/md.xsd">
  <cues>
    <cue name="InitMK4Semaphore" instantiate="true" version="1">
      <conditions>
        <check_any>
          <event_game_loaded/>
          <event_player_created/>
        </check_any>
      </conditions>
      <actions>
        <do_if value="not global.$GT_SearchSemaphore?">
          <signal_cue_instantly cue="md.GT_TradeSearch_Scheduler.InitSearchSemaphore"/>
        </do_if>
        <set_value name="global.$GT_SearchSemaphore.$MK4LiveQueueByHome" exact="table[]"/>
        <set_value name="global.$GT_SearchSemaphore.$MK4LiveHomesQueue" exact="[]"/>
        <set_value name="global.$GT_SearchSemaphore.$MK4LiveHomesQueued" exact="table[]"/>
        <set_value name="global.$GT_SearchSemaphore.$MK4LiveQueued" exact="table[]"/>
        <set_value name="global.$GT_SearchSemaphore.$MK4LiveActiveShips" exact="table[]"/>
        <set_value name="global.$GT_SearchSemaphore.$MK4LiveActive" exact="0"/>
        <set_value name="global.$GT_SearchSemaphore.$MK4LiveHomeActive" exact="table[]"/>
        <set_value name="global.$GT_SearchSemaphore.$MaxConcurrentMK4Live" exact="2"/>
        <set_value name="global.$GT_SearchSemaphore.$MK4LiveDispatchScheduled" exact="false"/>
        <set_value name="global.$GT_SearchSemaphore.$MK4LiveWaitersByHome" exact="table[]"/>
        <set_value name="global.$GT_SearchSemaphore.$MK4LiveWaiterQueuedByHome" exact="table[]"/>
        <set_value name="global.$GT_SearchSemaphore.$MK4LiveWaiterStartedAt" exact="table[]"/>
        <set_value name="global.$GT_SearchSemaphore.$MK4LiveWaiterTickScheduled" exact="false"/>
      </actions>
    </cue>

    <!-- MK4 fleet slot key (CONTEXT-009): sectors have no idcode, so the composite key uses
         homeSector.macro.id. All MK4Live queue/active/waiter tables that used to be keyed by
         home sector alone are keyed by this composite string so fleets sharing a home do not
         share dispatch/waiter state. -->
    <library name="GT_Mk4SlotKey" purpose="run_actions">
      <params>
        <param name="homeSector" default="null"/>
        <param name="fleetKey" default="''"/>
      </params>
      <actions>
        <set_value name="$slotHomeId" exact="if $homeSector? and $homeSector.exists and $homeSector.macro? and $homeSector.macro.id? then @$homeSector.macro.id else 'nohome'"/>
        <set_value name="$slotFleetKey" exact="if $fleetKey? and $fleetKey != '' then $fleetKey else 'nofleet'"/>
        <return value="'$' + $slotHomeId + '|' + $slotFleetKey"/>
      </actions>
    </library>

<cue name="DispatchMK4LiveSearchGoDelayed" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <delay min="200ms" max="1000ms"/>
      <actions>
        <do_if value="global.$GT_SearchSemaphore?">
          <set_value name="global.$GT_SearchSemaphore.$MK4LiveDispatchScheduled" exact="false"/>
        </do_if>
        <signal_cue_instantly cue="md.GT_TradeSearch_Scheduler_MK4.DispatchMK4LiveSearchGo"/>
      </actions>
    </cue>
<cue name="DispatchMK4LiveSearchGo" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <do_if value="not global.$GT_SearchSemaphore?">
          <signal_cue_instantly cue="md.GT_TradeSearch_Scheduler_MK4.InitSearchSemaphore"/>
        </do_if>
        <!-- Global self-heal for stale MK4Live live-active slots.
             Needed when legacy/aborted entries keep MK4LiveActive at capacity and block all new dispatches. -->
        <do_if value="global.$GT_SearchSemaphore.$MK4LiveActiveShips? and global.$GT_SearchSemaphore.$MK4LiveActiveShips.keys.count gt 0">
          <set_value name="$mk4ActiveKeys" exact="global.$GT_SearchSemaphore.$MK4LiveActiveShips.keys.list"/>
          <do_all exact="$mk4ActiveKeys.count" counter="$maki">
            <set_value name="$mk4ActiveShip" exact="$mk4ActiveKeys.{$maki}"/>
            <set_value name="$mk4ActiveEntry" exact="if $mk4ActiveShip? and global.$GT_SearchSemaphore.$MK4LiveActiveShips.{$mk4ActiveShip}? then @global.$GT_SearchSemaphore.$MK4LiveActiveShips.{$mk4ActiveShip} else null"/>
            <set_value name="$mk4ActiveStartedAt" exact="if $mk4ActiveEntry? and $mk4ActiveEntry.$StartedAt? then @$mk4ActiveEntry.$StartedAt else null"/>
            <set_value name="$mk4ActiveStale" exact="false"/>
            <do_if value="not $mk4ActiveShip? or ($mk4ActiveShip? and not $mk4ActiveShip.exists)">
              <set_value name="$mk4ActiveStale" exact="true"/>
            </do_if>
            <do_if value="not $mk4ActiveStale and ($mk4ActiveStartedAt == null or (player.age - $mk4ActiveStartedAt) gt 60s)">
              <set_value name="$mk4ActiveStale" exact="true"/>
            </do_if>
            <do_if value="$mk4ActiveStale">
              <do_if value="$mk4ActiveShip? and global.$GT_SearchSemaphore.$MK4LiveActiveShips.{$mk4ActiveShip}?">
                <remove_value name="global.$GT_SearchSemaphore.$MK4LiveActiveShips.{$mk4ActiveShip}"/>
              </do_if>
              <do_if value="global.$GT_SearchSemaphore.$MK4LiveActive gt 0">
                <set_value name="global.$GT_SearchSemaphore.$MK4LiveActive" operation="subtract"/>
              </do_if>
              <do_if value="$mk4ActiveEntry? and $mk4ActiveEntry.$HomeSector?">
                <set_value name="$mk4ActiveFleetKey" exact="if $mk4ActiveEntry.$FleetKey? then @$mk4ActiveEntry.$FleetKey else ''"/>
                <run_actions ref="md.GT_TradeSearch_Scheduler_MK4.GT_Mk4SlotKey" result="$mk4ActiveSlotKey">
                  <param name="homeSector" value="$mk4ActiveEntry.$HomeSector"/>
                  <param name="fleetKey" value="$mk4ActiveFleetKey"/>
                </run_actions>
                <do_if value="global.$GT_SearchSemaphore.$MK4LiveHomeActive? and global.$GT_SearchSemaphore.$MK4LiveHomeActive.{$mk4ActiveSlotKey}? and @global.$GT_SearchSemaphore.$MK4LiveHomeActive.{$mk4ActiveSlotKey} == $mk4ActiveShip">
                  <remove_value name="global.$GT_SearchSemaphore.$MK4LiveHomeActive.{$mk4ActiveSlotKey}"/>
                </do_if>
              </do_if>
              <do_if value="$mk4ActiveShip? and global.$GT_SearchSemaphore.$PhaseStateByShip? and global.$GT_SearchSemaphore.$PhaseStateByShip.{$mk4ActiveShip}? and @global.$GT_SearchSemaphore.$PhaseStateByShip.{$mk4ActiveShip} == 'mk4live_active'">
                <remove_value name="global.$GT_SearchSemaphore.$PhaseStateByShip.{$mk4ActiveShip}"/>
              </do_if>
              <do_if value="global.$GT_GlobalSettings? and global.$GT_GlobalSettings.$Debug? and @global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
                <debug_text text="'[GT-Scheduler] DispatchMK4LiveSearchGo: Cleared stale MK4Live active slot owner=' + (if $mk4ActiveShip? then $mk4ActiveShip.idcode else 'null') + ' startedAt=' + (if $mk4ActiveStartedAt? then $mk4ActiveStartedAt else 'null') + ' age=' + player.age" chance="100"/>
              </do_if>
            </do_if>
          </do_all>
        </do_if>

        <!-- Self-heal orphaned MK4LiveHomeActive slots (parity with MK3 LiveHomeActive). -->
        <set_value name="$mk4LiveStaleThreshold" exact="120s"/>
        <do_if value="global.$GT_GlobalSettings? and global.$GT_GlobalSettings.$Performance? and global.$GT_GlobalSettings.$Performance.$StaleThresholdSeconds?">
          <set_value name="$mk4LiveStaleThreshold" exact="@global.$GT_GlobalSettings.$Performance.$StaleThresholdSeconds"/>
        </do_if>
        <do_if value="global.$GT_SearchSemaphore.$MK4LiveHomeActive? and global.$GT_SearchSemaphore.$MK4LiveHomeActive.keys.count gt 0">
          <!-- Keys are composite fleet slot strings (CONTEXT-009), not sector objects - do not
               call sector-only properties (.knownname) on them. -->
          <set_value name="$mk4OrphanHomeKeys" exact="global.$GT_SearchSemaphore.$MK4LiveHomeActive.keys.list"/>
          <do_all exact="$mk4OrphanHomeKeys.count" counter="$mk4ohi">
            <set_value name="$mk4OrphanHome" exact="$mk4OrphanHomeKeys.{$mk4ohi}"/>
            <set_value name="$mk4OrphanOwner" exact="if $mk4OrphanHome? and global.$GT_SearchSemaphore.$MK4LiveHomeActive.{$mk4OrphanHome}? then @global.$GT_SearchSemaphore.$MK4LiveHomeActive.{$mk4OrphanHome} else null"/>
            <set_value name="$mk4OrphanHomeStale" exact="false"/>
            <do_if value="not $mk4OrphanOwner? or not $mk4OrphanOwner.exists">
              <set_value name="$mk4OrphanHomeStale" exact="true"/>
            </do_if>
            <do_if value="not $mk4OrphanHomeStale and global.$GT_SearchSemaphore.$MK4LiveActiveShips? and not global.$GT_SearchSemaphore.$MK4LiveActiveShips.{$mk4OrphanOwner}?">
              <set_value name="$mk4OrphanHomeStale" exact="true"/>
            </do_if>
            <do_if value="not $mk4OrphanHomeStale and global.$GT_SearchSemaphore.$MK4LiveActiveShips? and global.$GT_SearchSemaphore.$MK4LiveActiveShips.{$mk4OrphanOwner}?">
              <set_value name="$mk4OrphanOwnerEntry" exact="@global.$GT_SearchSemaphore.$MK4LiveActiveShips.{$mk4OrphanOwner}"/>
              <set_value name="$mk4OrphanOwnerStartedAt" exact="if $mk4OrphanOwnerEntry? and $mk4OrphanOwnerEntry.$StartedAt? then @$mk4OrphanOwnerEntry.$StartedAt else null"/>
              <do_if value="$mk4OrphanOwnerStartedAt == null or (player.age - $mk4OrphanOwnerStartedAt) gt $mk4LiveStaleThreshold">
                <set_value name="$mk4OrphanHomeStale" exact="true"/>
              </do_if>
            </do_if>
            <do_if value="$mk4OrphanHomeStale">
              <remove_value name="global.$GT_SearchSemaphore.$MK4LiveHomeActive.{$mk4OrphanHome}"/>
              <do_if value="global.$GT_GlobalSettings? and global.$GT_GlobalSettings.$Debug? and @global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
                <debug_text text="'[GT-Scheduler] DispatchMK4LiveSearchGo: Cleared orphaned MK4LiveHomeActive slot=' + (if $mk4OrphanHome? then $mk4OrphanHome else '?') + ' owner=' + (if $mk4OrphanOwner? then $mk4OrphanOwner.idcode else 'null')" chance="100"/>
              </do_if>
            </do_if>
          </do_all>
        </do_if>

        <do_if value="global.$GT_SearchSemaphore.$MK4LiveHomesQueue.count gt 0 and global.$GT_SearchSemaphore.$MK4LiveActive ge global.$GT_SearchSemaphore.$MaxConcurrentMK4Live">
          <do_if value="not global.$GT_SearchSemaphore.$MK4LiveDispatchScheduled">
            <set_value name="global.$GT_SearchSemaphore.$MK4LiveDispatchScheduled" exact="true"/>
            <signal_cue_instantly cue="md.GT_TradeSearch_Scheduler_MK4.DispatchMK4LiveSearchGoDelayed"/>
          </do_if>
        </do_if>
        <do_else>
          <!-- Fair round-robin by home sector -->
          <set_value name="$mk4HomeScanBudget" exact="global.$GT_SearchSemaphore.$MK4LiveHomesQueue.count"/>
          <do_while value="$mk4HomeScanBudget gt 0 and global.$GT_SearchSemaphore.$MK4LiveActive lt global.$GT_SearchSemaphore.$MaxConcurrentMK4Live and global.$GT_SearchSemaphore.$MK4LiveHomesQueue.count gt 0">
            <set_value name="$homeSector" exact="global.$GT_SearchSemaphore.$MK4LiveHomesQueue.{1}"/>
            <remove_from_list name="global.$GT_SearchSemaphore.$MK4LiveHomesQueue" exact="$homeSector"/>
            <remove_value name="global.$GT_SearchSemaphore.$MK4LiveHomesQueued.{$homeSector}"/>
            <set_value name="$mk4HomeScanBudget" operation="subtract"/>

            <do_if value="not global.$GT_SearchSemaphore.$MK4LiveQueueByHome? or not global.$GT_SearchSemaphore.$MK4LiveQueueByHome.{$homeSector}? or global.$GT_SearchSemaphore.$MK4LiveQueueByHome.{$homeSector}.count le 0">
              <continue/>
            </do_if>

            <!-- Peek (do not pop) the head entry to learn which fleet slot it needs. Active-slot
                 gating is per (home, fleetKey) so a different fleet homed in the same sector is not
                 blocked by another fleet's in-flight live search (CONTEXT-009). -->
            <set_value name="$entry" exact="@global.$GT_SearchSemaphore.$MK4LiveQueueByHome.{$homeSector}.{1}"/>
            <set_value name="$entryFleetKey" exact="if $entry? and $entry.$FleetKey? then @$entry.$FleetKey else ''"/>
            <run_actions ref="md.GT_TradeSearch_Scheduler_MK4.GT_Mk4SlotKey" result="$mk4SlotKey">
              <param name="homeSector" value="$homeSector"/>
              <param name="fleetKey" value="$entryFleetKey"/>
            </run_actions>

            <!-- Skip fleet slots that are currently active; requeue home to tail -->
            <do_if value="global.$GT_SearchSemaphore.$MK4LiveHomeActive? and global.$GT_SearchSemaphore.$MK4LiveHomeActive.{$mk4SlotKey}?">
              <do_if value="not global.$GT_SearchSemaphore.$MK4LiveHomesQueued.{$homeSector}?">
                <append_to_list name="global.$GT_SearchSemaphore.$MK4LiveHomesQueue" exact="$homeSector"/>
                <set_value name="global.$GT_SearchSemaphore.$MK4LiveHomesQueued.{$homeSector}" exact="true"/>
              </do_if>
              <continue/>
            </do_if>

            <remove_value name="global.$GT_SearchSemaphore.$MK4LiveQueueByHome.{$homeSector}.{1}"/>

            <set_value name="$ship" exact="@$entry.$Ship"/>
            <set_value name="$params" exact="@$entry.$Params"/>
            <set_value name="$dispatchParams" exact="if $params? then $params else table[]"/>
            <set_value name="$dispatchParams.$Phase" exact="'mk4live'"/>
            <set_value name="$dispatchParams.$HomeSector" exact="$homeSector"/>
            <set_value name="$dispatchParams.$FleetKey" exact="$entryFleetKey"/>
            <set_value name="$dispatchParams.$SearchPool" exact="'mk4_supply'"/>
            <!-- Honor an explicit ship request for a live search. A ship raises ForceLiveSearch=true only
                 after its cache attempt already failed (every cached candidate rejected for THIS ship). If we
                 silently downgrade to a cache re-read whenever the shared pool is non-empty, the ship is handed
                 the very same already-failing entries again and loops forever, never discovering the live demand
                 that other ships have not claimed (observed: FIK/FOB stuck re-reading CUP's pool of 30, never
                 running a live search). Only apply the cache-first heuristic when the ship did NOT explicitly
                 force live. -->
            <set_value name="$shipForcedLive" exact="$params? and $params.$ForceLiveSearch? and @$params.$ForceLiveSearch"/>
            <set_value name="$dispatchForceLive" exact="true"/>
            <do_if value="not $shipForcedLive and $homeSector? and $homeSector.exists and global.$GT_TradeCacheMK4? and global.$GT_TradeCacheMK4.{$homeSector}? and typeof global.$GT_TradeCacheMK4.{$homeSector} == datatype.table and global.$GT_TradeCacheMK4.{$homeSector}.{$entryFleetKey}? and global.$GT_TradeCacheMK4.{$homeSector}.{$entryFleetKey}.count gt 0">
              <set_value name="$dispatchForceLive" exact="false"/>
            </do_if>
            <set_value name="$dispatchParams.$ForceLiveSearch" exact="$dispatchForceLive"/>

            <do_if value="$ship? and $ship.exists">
              <set_value name="global.$GT_SearchSemaphore.$MK4LiveActive" operation="add"/>
              <set_value name="global.$GT_SearchSemaphore.$MK4LiveActiveShips.{$ship}" exact="table[
                $StartedAt = player.age,
                $Params = $dispatchParams,
                $HomeSector = $homeSector,
                $FleetKey = $entryFleetKey
              ]"/>
              <set_value name="global.$GT_SearchSemaphore.$MK4LiveHomeActive.{$mk4SlotKey}" exact="$ship"/>
              <remove_value name="global.$GT_SearchSemaphore.$MK4LiveQueued.{$ship}"/>
              <set_value name="global.$GT_SearchSemaphore.$PhaseStateByShip.{$ship}" exact="'mk4live_active'"/>
              <do_if value="global.$GT_GlobalSettings? and global.$GT_GlobalSettings.$Debug? and @global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
                <debug_text text="'[GT-Scheduler] DispatchMK4LiveSearchGo: Sending GT_Search_Go to ' + $ship.idcode + ' (age=' + player.age + ', mk4live)'" chance="100"/>
              </do_if>
              <signal_objects object="$ship" param="'GT_Search_Go'" param2="$dispatchParams" delay="1ms"/>
            </do_if>
            <do_else>
              <do_if value="$ship? and global.$GT_SearchSemaphore.$MK4LiveQueued? and global.$GT_SearchSemaphore.$MK4LiveQueued.{$ship}?">
                <remove_value name="global.$GT_SearchSemaphore.$MK4LiveQueued.{$ship}"/>
              </do_if>
              <do_if value="$ship? and global.$GT_SearchSemaphore.$PhaseStateByShip? and global.$GT_SearchSemaphore.$PhaseStateByShip.{$ship}?">
                <remove_value name="global.$GT_SearchSemaphore.$PhaseStateByShip.{$ship}"/>
              </do_if>
            </do_else>

            <!-- Keep home queued if there are still pending MK4Live live entries for this home -->
            <do_if value="global.$GT_SearchSemaphore.$MK4LiveQueueByHome? and global.$GT_SearchSemaphore.$MK4LiveQueueByHome.{$homeSector}? and global.$GT_SearchSemaphore.$MK4LiveQueueByHome.{$homeSector}.count gt 0">
              <do_if value="not global.$GT_SearchSemaphore.$MK4LiveHomesQueued.{$homeSector}?">
                <append_to_list name="global.$GT_SearchSemaphore.$MK4LiveHomesQueue" exact="$homeSector"/>
                <set_value name="global.$GT_SearchSemaphore.$MK4LiveHomesQueued.{$homeSector}" exact="true"/>
              </do_if>
            </do_if>
          </do_while>
        </do_else>
      </actions>
    </cue>
<cue name="NotifyMK4LiveWaitersTick" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <delay exact="20s"/>
      <actions>
        <set_value name="$hasAnyMK4LiveActiveWaiters" exact="false"/>
        <set_value name="$mk4WaiterStaleThreshold" exact="120s"/>
        <do_if value="global.$GT_GlobalSettings? and global.$GT_GlobalSettings.$Performance? and global.$GT_GlobalSettings.$Performance.$StaleThresholdSeconds?">
          <set_value name="$mk4WaiterStaleThreshold" exact="@global.$GT_GlobalSettings.$Performance.$StaleThresholdSeconds"/>
        </do_if>
        <!-- $MK4LiveWaitersByHome/$MK4LiveWaiterStartedAt/$MK4LiveHomeActive are keyed by the
             composite fleet slot string (CONTEXT-009), not a sector object - $mk4HomeSector below
             is that slot key and must not call sector-only properties (.knownname) on it. -->
        <do_if value="global.$GT_SearchSemaphore? and global.$GT_SearchSemaphore.$MK4LiveWaitersByHome? and global.$GT_SearchSemaphore.$MK4LiveWaitersByHome.keys.count gt 0">
          <set_value name="$mk4HomeKeys" exact="global.$GT_SearchSemaphore.$MK4LiveWaitersByHome.keys.list"/>
          <do_all exact="$mk4HomeKeys.count" counter="$mk4hki">
            <set_value name="$mk4HomeSector" exact="$mk4HomeKeys.{$mk4hki}"/>
            <do_if value="$mk4HomeSector? and global.$GT_SearchSemaphore.$MK4LiveWaitersByHome.{$mk4HomeSector}? and global.$GT_SearchSemaphore.$MK4LiveWaitersByHome.{$mk4HomeSector}.count gt 0">
              <set_value name="$mk4HomeOwner" exact="if global.$GT_SearchSemaphore.$MK4LiveHomeActive? and global.$GT_SearchSemaphore.$MK4LiveHomeActive.{$mk4HomeSector}? then @global.$GT_SearchSemaphore.$MK4LiveHomeActive.{$mk4HomeSector} else null"/>
              <set_value name="$mk4HomeOwnerStale" exact="false"/>
              <do_if value="not $mk4HomeOwner? or not $mk4HomeOwner.exists">
                <set_value name="$mk4HomeOwnerStale" exact="true"/>
              </do_if>
              <do_if value="not $mk4HomeOwnerStale and global.$GT_SearchSemaphore.$MK4LiveActiveShips? and not global.$GT_SearchSemaphore.$MK4LiveActiveShips.{$mk4HomeOwner}?">
                <set_value name="$mk4HomeOwnerStale" exact="true"/>
              </do_if>
              <do_if value="not $mk4HomeOwnerStale and global.$GT_SearchSemaphore.$MK4LiveActiveShips? and global.$GT_SearchSemaphore.$MK4LiveActiveShips.{$mk4HomeOwner}?">
                <set_value name="$mk4HomeOwnerEntry" exact="@global.$GT_SearchSemaphore.$MK4LiveActiveShips.{$mk4HomeOwner}"/>
                <set_value name="$mk4HomeOwnerStartedAt" exact="if $mk4HomeOwnerEntry? and $mk4HomeOwnerEntry.$StartedAt? then @$mk4HomeOwnerEntry.$StartedAt else null"/>
                <do_if value="$mk4HomeOwnerStartedAt == null or (player.age - $mk4HomeOwnerStartedAt) gt $mk4WaiterStaleThreshold">
                  <set_value name="$mk4HomeOwnerStale" exact="true"/>
                </do_if>
              </do_if>
              <do_if value="$mk4HomeOwnerStale and global.$GT_SearchSemaphore.$MK4LiveHomeActive? and global.$GT_SearchSemaphore.$MK4LiveHomeActive.{$mk4HomeSector}?">
                <remove_value name="global.$GT_SearchSemaphore.$MK4LiveHomeActive.{$mk4HomeSector}"/>
              </do_if>
              <do_if value="$mk4HomeOwnerStale and $mk4HomeOwner? and global.$GT_SearchSemaphore.$MK4LiveActiveShips? and global.$GT_SearchSemaphore.$MK4LiveActiveShips.{$mk4HomeOwner}?">
                <remove_value name="global.$GT_SearchSemaphore.$MK4LiveActiveShips.{$mk4HomeOwner}"/>
                <do_if value="global.$GT_SearchSemaphore.$MK4LiveActive gt 0">
                  <set_value name="global.$GT_SearchSemaphore.$MK4LiveActive" operation="subtract"/>
                </do_if>
              </do_if>

              <do_all exact="global.$GT_SearchSemaphore.$MK4LiveWaitersByHome.{$mk4HomeSector}.count" counter="$mk4wi" reverse="true">
                <set_value name="$mk4wShip" exact="global.$GT_SearchSemaphore.$MK4LiveWaitersByHome.{$mk4HomeSector}.{$mk4wi}"/>
                <do_if value="not $mk4wShip? or not $mk4wShip.exists">
                  <remove_value name="global.$GT_SearchSemaphore.$MK4LiveWaitersByHome.{$mk4HomeSector}.{$mk4wi}"/>
                  <continue/>
                </do_if>
                <set_value name="$mk4WaiterAge" exact="0s"/>
                <do_if value="global.$GT_SearchSemaphore.$MK4LiveWaiterStartedAt? and global.$GT_SearchSemaphore.$MK4LiveWaiterStartedAt.{$mk4HomeSector}? and global.$GT_SearchSemaphore.$MK4LiveWaiterStartedAt.{$mk4HomeSector}.{$mk4wShip}?">
                  <set_value name="$mk4WaiterAge" exact="player.age - @global.$GT_SearchSemaphore.$MK4LiveWaiterStartedAt.{$mk4HomeSector}.{$mk4wShip}"/>
                </do_if>
                <set_value name="$mk4PromoteWaiter" exact="false"/>
                <do_if value="$mk4HomeOwnerStale or $mk4WaiterAge gt $mk4WaiterStaleThreshold">
                  <set_value name="$mk4PromoteWaiter" exact="true"/>
                </do_if>
                <do_if value="$mk4PromoteWaiter">
                  <remove_value name="global.$GT_SearchSemaphore.$MK4LiveWaitersByHome.{$mk4HomeSector}.{$mk4wi}"/>
                  <do_if value="global.$GT_SearchSemaphore.$MK4LiveWaiterQueuedByHome? and global.$GT_SearchSemaphore.$MK4LiveWaiterQueuedByHome.{$mk4HomeSector}? and global.$GT_SearchSemaphore.$MK4LiveWaiterQueuedByHome.{$mk4HomeSector}.{$mk4wShip}?">
                    <remove_value name="global.$GT_SearchSemaphore.$MK4LiveWaiterQueuedByHome.{$mk4HomeSector}.{$mk4wShip}"/>
                  </do_if>
                  <do_if value="global.$GT_SearchSemaphore.$MK4LiveWaiterStartedAt? and global.$GT_SearchSemaphore.$MK4LiveWaiterStartedAt.{$mk4HomeSector}? and global.$GT_SearchSemaphore.$MK4LiveWaiterStartedAt.{$mk4HomeSector}.{$mk4wShip}?">
                    <remove_value name="global.$GT_SearchSemaphore.$MK4LiveWaiterStartedAt.{$mk4HomeSector}.{$mk4wShip}"/>
                  </do_if>
                  <set_value name="global.$GT_SearchSemaphore.$LiveWaiterWakePending.{$mk4wShip}" exact="true"/>
                  <signal_cue_instantly cue="md.GT_TradeSearch_Scheduler.SignalTradeSearchResetStaggered" param="$mk4wShip"/>
                  <do_if value="global.$GT_GlobalSettings? and global.$GT_GlobalSettings.$Debug? and @global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
                    <debug_text text="'[GT-Scheduler] NotifyMK4LiveWaitersTick: Promoted starved MK4Live waiter ' + $mk4wShip.idcode + ' slot=' + $mk4HomeSector + ' waiterAge=' + $mk4WaiterAge + ' homeOwnerStale=' + $mk4HomeOwnerStale" chance="100"/>
                  </do_if>
                </do_if>
              </do_all>

              <!-- Keep MK4Live tick alive without broadcasting InProgress to every waiter. -->
              <do_if value="global.$GT_SearchSemaphore.$MK4LiveWaitersByHome.{$mk4HomeSector}? and global.$GT_SearchSemaphore.$MK4LiveWaitersByHome.{$mk4HomeSector}.count gt 0 and global.$GT_SearchSemaphore.$MK4LiveHomeActive? and global.$GT_SearchSemaphore.$MK4LiveHomeActive.{$mk4HomeSector}?">
                <set_value name="$hasAnyMK4LiveActiveWaiters" exact="true"/>
              </do_if>
            </do_if>
          </do_all>
        </do_if>

        <do_if value="$hasAnyMK4LiveActiveWaiters">
          <set_value name="global.$GT_SearchSemaphore.$MK4LiveWaiterTickScheduled" exact="true"/>
          <signal_cue_instantly cue="md.GT_TradeSearch_Scheduler_MK4.NotifyMK4LiveWaitersTick"/>
        </do_if>
        <do_else>
          <set_value name="global.$GT_SearchSemaphore.$MK4LiveWaiterTickScheduled" exact="false"/>
        </do_else>
        <signal_cue_instantly cue="md.GT_TradeSearch_Scheduler_MK4.DispatchMK4LiveSearchGo"/>
      </actions>
    </cue>
<cue name="HandleMK4CacheUpdated" instantiate="true">
      <conditions>
        <event_object_signalled object="player.galaxy" param="'GT_MK4_Cache_Updated'"/>
      </conditions>
      <actions>
        <set_value name="$data" exact="event.param2"/>
        <set_value name="$homeSector" exact="@$data.$HomeSector"/>
        <!-- Fleet-scoped wake (CONTEXT-009): the cache write only touched one fleet's bucket at
             this home, so only that fleet's queue/waiter entries are woken and only that fleet's
             FailedShips markers are cleared. A write without a fleet key (MK3 writer, or a stale
             pre-fleet-key caller) is not an MK4 wake source. -->
        <set_value name="$mk4EventFleetKey" exact="if $data? and $data.$FleetKey? then @$data.$FleetKey else ''"/>
        <set_value name="$updatedMaxDistance" exact="if $data? and $data.$MaxDistance != null then @$data.$MaxDistance else 0"/>
        <do_if value="not global.$GT_SearchSemaphore?">
          <signal_cue_instantly cue="md.GT_TradeSearch_Scheduler_MK4.InitSearchSemaphore"/>
        </do_if>
        <do_if value="$homeSector? and $homeSector.exists and $mk4EventFleetKey != '' and global.$GT_SearchSemaphore?">
          <run_actions ref="md.GT_TradeSearch_Scheduler_MK4.GT_Mk4SlotKey" result="$mk4CacheSlotKey">
            <param name="homeSector" value="$homeSector"/>
            <param name="fleetKey" value="$mk4EventFleetKey"/>
          </run_actions>
          <set_value name="$mk4CacheEntryCount" exact="0"/>
          <do_if value="global.$GT_TradeCacheMK4? and global.$GT_TradeCacheMK4.{$homeSector}? and typeof global.$GT_TradeCacheMK4.{$homeSector} == datatype.table and global.$GT_TradeCacheMK4.{$homeSector}.{$mk4EventFleetKey}?">
            <set_value name="$mk4CacheEntryCount" exact="@global.$GT_TradeCacheMK4.{$homeSector}.{$mk4EventFleetKey}.count"/>
          </do_if>
          <do_if value="$mk4CacheEntryCount gt 0 and $data? and $data.$Written? and $data.$Written gt 0">
            <!-- Fresh cache writes supersede prior per-ship skip markers, scoped to this fleet's bucket only. -->
            <do_all exact="global.$GT_TradeCacheMK4.{$homeSector}.{$mk4EventFleetKey}.count" counter="$mk4clrCi">
              <set_value name="$mk4clrEntry" exact="global.$GT_TradeCacheMK4.{$homeSector}.{$mk4EventFleetKey}.{$mk4clrCi}"/>
              <do_if value="$mk4clrEntry? and $mk4clrEntry.$FailedShips? and $mk4clrEntry.$FailedShips.count gt 0">
                <set_value name="$mk4clrEntry.$FailedShips" exact="[]"/>
                <set_value name="$mk4clrEntry.$FailedShipIdcodes" exact="[]"/>
                <set_value name="global.$GT_TradeCacheMK4.{$homeSector}.{$mk4EventFleetKey}.{$mk4clrCi}" exact="$mk4clrEntry"/>
              </do_if>
            </do_all>
            <set_value name="$mk4WakeShips" exact="[]"/>
            <set_value name="$mk4WakeShipSeen" exact="table[]"/>
            <!-- MK4Live live queue waiters for THIS fleet only ($MK4LiveQueueByHome stays keyed by
                 home and mixes fleets in one FIFO list - filter by each entry's own $FleetKey).
                 DEQUEUE on wake: GT_TradeSearch_Reset treats MK4LiveQueued as still-scheduled and
                 resumes wait without clearing ForceLive / re-requesting cache. Leaving ships on the
                 live queue after a cache fill made the wake a no-op (Reset log spam, then mk4live Go
                 against a full pool). -->
            <do_if value="global.$GT_SearchSemaphore.$MK4LiveQueueByHome? and global.$GT_SearchSemaphore.$MK4LiveQueueByHome.{$homeSector}? and global.$GT_SearchSemaphore.$MK4LiveQueueByHome.{$homeSector}.count gt 0">
              <do_all exact="global.$GT_SearchSemaphore.$MK4LiveQueueByHome.{$homeSector}.count" counter="$mk4cwi" reverse="true">
                <set_value name="$mk4cwEntry" exact="@global.$GT_SearchSemaphore.$MK4LiveQueueByHome.{$homeSector}.{$mk4cwi}"/>
                <set_value name="$mk4cwShip" exact="if $mk4cwEntry? and $mk4cwEntry.$Ship? then @$mk4cwEntry.$Ship else null"/>
                <set_value name="$mk4cwFleetKey" exact="if $mk4cwEntry? and $mk4cwEntry.$FleetKey? then @$mk4cwEntry.$FleetKey else ''"/>
                <do_if value="$mk4cwShip? and $mk4cwShip.exists and $mk4cwFleetKey == $mk4EventFleetKey">
                  <do_if value="not $mk4WakeShipSeen.{$mk4cwShip}?">
                    <append_to_list name="$mk4WakeShips" exact="$mk4cwShip"/>
                    <set_value name="$mk4WakeShipSeen.{$mk4cwShip}" exact="true"/>
                  </do_if>
                  <remove_value name="global.$GT_SearchSemaphore.$MK4LiveQueueByHome.{$homeSector}.{$mk4cwi}"/>
                  <do_if value="global.$GT_SearchSemaphore.$MK4LiveQueued? and global.$GT_SearchSemaphore.$MK4LiveQueued.{$mk4cwShip}?">
                    <remove_value name="global.$GT_SearchSemaphore.$MK4LiveQueued.{$mk4cwShip}"/>
                  </do_if>
                  <do_if value="global.$GT_SearchSemaphore.$PhaseStateByShip? and global.$GT_SearchSemaphore.$PhaseStateByShip.{$mk4cwShip}?">
                    <remove_value name="global.$GT_SearchSemaphore.$PhaseStateByShip.{$mk4cwShip}"/>
                  </do_if>
                </do_if>
              </do_all>
            </do_if>
            <!-- Legacy live queue (mk4PolicyNeedsLiveSearch path; pre-fleet-key, home-scoped only) -->
            <do_if value="global.$GT_SearchSemaphore.$LiveQueueByHome? and global.$GT_SearchSemaphore.$LiveQueueByHome.{$homeSector}? and global.$GT_SearchSemaphore.$LiveQueueByHome.{$homeSector}.count gt 0">
              <do_all exact="global.$GT_SearchSemaphore.$LiveQueueByHome.{$homeSector}.count" counter="$lcwi" reverse="true">
                <set_value name="$lcwEntry" exact="@global.$GT_SearchSemaphore.$LiveQueueByHome.{$homeSector}.{$lcwi}"/>
                <set_value name="$lcwShip" exact="if $lcwEntry? and $lcwEntry.$Ship? then @$lcwEntry.$Ship else null"/>
                <do_if value="$lcwShip? and $lcwShip.exists">
                  <do_if value="not $mk4WakeShipSeen.{$lcwShip}?">
                    <append_to_list name="$mk4WakeShips" exact="$lcwShip"/>
                    <set_value name="$mk4WakeShipSeen.{$lcwShip}" exact="true"/>
                  </do_if>
                  <remove_value name="global.$GT_SearchSemaphore.$LiveQueueByHome.{$homeSector}.{$lcwi}"/>
                  <do_if value="global.$GT_SearchSemaphore.$LiveQueued? and global.$GT_SearchSemaphore.$LiveQueued.{$lcwShip}?">
                    <remove_value name="global.$GT_SearchSemaphore.$LiveQueued.{$lcwShip}"/>
                  </do_if>
                  <do_if value="global.$GT_SearchSemaphore.$PhaseStateByShip? and global.$GT_SearchSemaphore.$PhaseStateByShip.{$lcwShip}?">
                    <remove_value name="global.$GT_SearchSemaphore.$PhaseStateByShip.{$lcwShip}"/>
                  </do_if>
                </do_if>
              </do_all>
            </do_if>
            <!-- MK4Live live refresh waiters blocked on THIS fleet's slot ($MK4LiveWaitersByHome is
                 keyed by composite slot key, so this is a direct lookup, not a home-wide scan).
                 Dequeue so Reset does not treat waiter membership as still-scheduled. -->
            <do_if value="global.$GT_SearchSemaphore.$MK4LiveWaitersByHome? and global.$GT_SearchSemaphore.$MK4LiveWaitersByHome.{$mk4CacheSlotKey}? and global.$GT_SearchSemaphore.$MK4LiveWaitersByHome.{$mk4CacheSlotKey}.count gt 0">
              <do_all exact="global.$GT_SearchSemaphore.$MK4LiveWaitersByHome.{$mk4CacheSlotKey}.count" counter="$mk4wwi" reverse="true">
                <set_value name="$mk4wwShip" exact="@global.$GT_SearchSemaphore.$MK4LiveWaitersByHome.{$mk4CacheSlotKey}.{$mk4wwi}"/>
                <do_if value="$mk4wwShip? and $mk4wwShip.exists">
                  <do_if value="not $mk4WakeShipSeen.{$mk4wwShip}?">
                    <append_to_list name="$mk4WakeShips" exact="$mk4wwShip"/>
                    <set_value name="$mk4WakeShipSeen.{$mk4wwShip}" exact="true"/>
                  </do_if>
                  <remove_value name="global.$GT_SearchSemaphore.$MK4LiveWaitersByHome.{$mk4CacheSlotKey}.{$mk4wwi}"/>
                  <do_if value="global.$GT_SearchSemaphore.$MK4LiveWaiterQueuedByHome? and global.$GT_SearchSemaphore.$MK4LiveWaiterQueuedByHome.{$mk4CacheSlotKey}? and global.$GT_SearchSemaphore.$MK4LiveWaiterQueuedByHome.{$mk4CacheSlotKey}.{$mk4wwShip}?">
                    <remove_value name="global.$GT_SearchSemaphore.$MK4LiveWaiterQueuedByHome.{$mk4CacheSlotKey}.{$mk4wwShip}"/>
                  </do_if>
                  <do_if value="global.$GT_SearchSemaphore.$MK4LiveWaiterStartedAt? and global.$GT_SearchSemaphore.$MK4LiveWaiterStartedAt.{$mk4CacheSlotKey}? and global.$GT_SearchSemaphore.$MK4LiveWaiterStartedAt.{$mk4CacheSlotKey}.{$mk4wwShip}?">
                    <remove_value name="global.$GT_SearchSemaphore.$MK4LiveWaiterStartedAt.{$mk4CacheSlotKey}.{$mk4wwShip}"/>
                  </do_if>
                </do_if>
              </do_all>
            </do_if>
            <!-- Cache-phase queue for same home (pre-fleet-key cache phase, home-scoped only) -->
            <do_if value="global.$GT_SearchSemaphore.$CacheQueue? and global.$GT_SearchSemaphore.$CacheQueue.count gt 0">
              <do_all exact="global.$GT_SearchSemaphore.$CacheQueue.count" counter="$ccwi">
                <set_value name="$ccwEntry" exact="@global.$GT_SearchSemaphore.$CacheQueue.{$ccwi}"/>
                <set_value name="$ccwShip" exact="if $ccwEntry? and $ccwEntry.$Ship? then @$ccwEntry.$Ship else null"/>
                <set_value name="$ccwHome" exact="if $ccwEntry? and $ccwEntry.$HomeSector? then @$ccwEntry.$HomeSector else null"/>
                <do_if value="$ccwShip? and $ccwShip.exists and $ccwHome? and $ccwHome == $homeSector and not $mk4WakeShipSeen.{$ccwShip}?">
                  <append_to_list name="$mk4WakeShips" exact="$ccwShip"/>
                  <set_value name="$mk4WakeShipSeen.{$ccwShip}" exact="true"/>
                </do_if>
              </do_all>
            </do_if>
            <do_if value="$mk4WakeShips.count gt 0">
              <signal_cue_instantly cue="md.GT_TradeSearch_Scheduler.SignalCacheUpdatedWakeStaggered" param="table[$Ships = $mk4WakeShips, $Index = 1]"/>
            </do_if>
            <do_if value="$mk4WakeShips.count gt 0 and global.$GT_GlobalSettings? and global.$GT_GlobalSettings.$Debug? and @global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
              <debug_text text="'[GT-Scheduler] HandleMK4CacheUpdated: Woke ' + $mk4WakeShips.count + ' waiting ships to retry cache home=' + (if $homeSector.knownname? then @$homeSector.knownname else '?') + ' fleetKey=' + $mk4EventFleetKey + ' pool=' + $mk4CacheEntryCount + ' maxDist=' + $updatedMaxDistance" chance="100"/>
            </do_if>
          </do_if>
        </do_if>
      </actions>
    </cue>

    <!-- Save/load recovery: an AI <wait> does not re-issue its trade-search request after a
         game load (the pre-save GT_Search_Request was discarded when the scheduler queues were
         reset on load), so MK4 ships sit in 'wait for MD response' forever until the order is
         manually re-applied. Re-kick every in-service MK4 ship once on load with
         GT_TradeSearch_Reset: the order's wait interrupt sees it is no longer scheduled (queues
         were just reset) and resumes its main loop, sending a fresh GT_Search_Request.
         One-shot and event-driven (no polling). The delay lets InitMK4Semaphore and the main
         scheduler's load-time reservation clear (2s) settle first. Ships that are actively
         executing a trade are unaffected (GT_TradeSearch_Reset is only caught in the response wait). -->
    <cue name="MK4ReinitShipsOnLoad" instantiate="true" version="1">
      <conditions>
        <event_game_loaded/>
      </conditions>
      <delay exact="5s"/>
      <actions>
        <do_if value="global.$GT_Ships? and global.$GT_Ships.keys.count gt 0">
          <set_value name="$mk4LoadShipKeys" exact="global.$GT_Ships.keys.list"/>
          <set_value name="$mk4LoadKicked" exact="0"/>
          <do_all exact="$mk4LoadShipKeys.count" counter="$mk4lki">
            <set_value name="$mk4LoadShip" exact="$mk4LoadShipKeys.{$mk4lki}"/>
            <do_if value="$mk4LoadShip? and $mk4LoadShip.exists and $mk4LoadShip.isplayerowned and $mk4LoadShip.defaultorder?">
              <set_value name="$mk4LoadIsMk4" exact="false"/>
              <do_if value="@$mk4LoadShip.defaultorder.id == 'GalaxyTraderMK4Supply'">
                <set_value name="$mk4LoadIsMk4" exact="true"/>
              </do_if>
              <do_elseif value="@$mk4LoadShip.defaultorder.id == 'Assist' and $mk4LoadShip.defaultorder.$baseorder? and @$mk4LoadShip.defaultorder.$baseorder.id == 'GalaxyTraderMK4Supply'">
                <set_value name="$mk4LoadIsMk4" exact="true"/>
              </do_elseif>
              <do_if value="$mk4LoadIsMk4">
                <signal_objects object="$mk4LoadShip" param="'GT_TradeSearch_Reset'" delay="1ms"/>
                <set_value name="$mk4LoadKicked" operation="add"/>
              </do_if>
            </do_if>
          </do_all>
          <do_if value="$mk4LoadKicked gt 0 and global.$GT_GlobalSettings? and global.$GT_GlobalSettings.$Debug? and @global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
            <debug_text text="'[GT-Scheduler] MK4ReinitShipsOnLoad: re-kicked ' + $mk4LoadKicked + ' MK4 ship(s) to resume trade search after game load'" chance="100"/>
          </do_if>
        </do_if>
      </actions>
    </cue>
  </cues>
</mdscript>
