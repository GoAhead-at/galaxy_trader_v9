<?xml version="1.0" encoding="utf-8"?>
<!-- lib.gt.pay.account — which account the engine bills for a GT buy leg.
     Vanilla reads this.container.money for the buy affordability clamp (order.trade.perform:
     "not enough money", player.interaction.tradefailed: "our account"); that balance is funded from
     the homebase, which trade.find.commander switches to the commander station. So the funding
     source is the nearest station in the ship's commander chain, else the owner wallet.
     MinPlayerMoney is a player-wallet reserve — callers apply it only when $IsPlayerWallet.
     No <wait>: called from money gates during trade search and mid queue construction. -->
<aiscript name="lib.gt.pay.account" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../stock_game/X4 Foundations/libraries/aiscripts.xsd" version="1">
  <params>
    <param name="ship" default="this.ship"/>
  </params>
  <attention min="unknown">
    <actions>
      <!-- A ship never funds itself: container.hasownaccount only reports the temporary account
           vanilla opens for an in-flight trade order (GT clears stale ones pre-search), so it holds
           money already committed to that order, not the source of the next purchase. Walk up to
           the first station the same way vanilla resolves $homebase. Hop guard: a corrupt commander
           cycle must not spin this loop. -->
      <set_value name="$account" exact="null"/>
      <do_if value="$ship? and @$ship.exists">
        <set_value name="$hop" exact="if $ship.commander? and @$ship.commander.exists and @$ship.commander != $ship then @$ship.commander else null"/>
        <set_value name="$hops" exact="0"/>
        <do_while value="$account == null and $hop != null and $hops lt 8">
          <set_value name="$hops" operation="add"/>
          <do_if value="@$hop.isclass.station">
            <set_value name="$account" exact="$hop"/>
          </do_if>
          <do_else>
            <set_value name="$hop" exact="if $hop.commander? and @$hop.commander.exists and @$hop.commander != $hop then @$hop.commander else null"/>
          </do_else>
        </do_while>
      </do_if>

      <set_value name="$isPlayerWallet" exact="$account == null"/>
      <set_value name="$money" exact="if $account != null then @$account.money else player.money"/>

      <return value="table[
        $Money = if $money? and $money != null then $money else 0,
        $Account = $account,
        $IsPlayerWallet = $isPlayerWallet
      ]"/>
    </actions>
  </attention>
</aiscript>
