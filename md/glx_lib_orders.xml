<?xml version="1.0" encoding="utf-8"?>
<mdscript name="GLX_Lib_Orders" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../stock_game/X4 Foundations/libraries/md.xsd">
  <cues>
    <!-- Centralized checks against global.$GT_ProtectedOrderIDs (see gt_core_system.xml). -->
    <!-- Use md.GLX_Lib_Orders.GLX_ShipIsInGTService from run_actions, or inline indexof in hot do_if conditions. -->

    <!-- True if ship's default order is a protected GT id, OR Assist under a GT commander (any Assist depth). -->
    <library name="GLX_ShipIsInGTService" purpose="run_actions">
      <params>
        <param name="ship" comment="Ship to test"/>
      </params>
      <actions>
        <do_if value="$ship? and $ship.exists and global.$GT_ProtectedOrderIDs? and $ship.defaultorder? and global.$GT_ProtectedOrderIDs.indexof.{@$ship.defaultorder.id}">
          <return value="true"/>
        </do_if>
        <!-- Assist: walk the Assist chain the same way cleanup does (GT_CheckCommanderStatus, up to 6
             levels), so a nested subordinate counts as GT-controlled here too -->
        <do_if value="$ship? and $ship.exists and $ship.defaultorder? and @$ship.defaultorder.id == 'Assist'">
          <run_actions ref="md.GT_Ship_State_Utilities.GT_IsSubordinateOfGTCommander" result="$assistUnderGT">
            <param name="ship" value="$ship"/>
          </run_actions>
          <do_if value="$assistUnderGT">
            <return value="true"/>
          </do_if>
        </do_if>
        <return value="false"/>
      </actions>
    </library>
  </cues>
</mdscript>
