<?xml version="1.0" encoding="utf-8"?>
<aiscript name="lib.gt.miner.sell.search" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../stock_game/X4 Foundations/libraries/aiscripts.xsd" version="1">
  <!--
    Galaxy Miner overflow sell-offer cache read. Dedicated pool; never touches GT_TradeCache (MK3),
    GT_TradeCacheMK4, GT_TradeCacheMK1 or GT_MinerDemandCache (which caches the demand half).

    Storage: global.$GT_TradeCacheMinerSell.{poolKey}
      poolKey = '$' + refSectorMacro + '|d' + maxSell + '|o' + ownerFilter
                + '|t' + ignoreTradeRules + '|i' + allowIllegal

    Two callers share this pool: the overflow ware-ranking search in order.trade.galaxyminer, and
    the per-trip cargo sell search in order.mining.routine.gt. Both ask the same question - which
    stations in range will buy these wares - and the answer depends only on the sell-space set
    (ref sector + jump radius) and the owner/legality filters, so every miner sharing a mining range
    shares a pool. Owner filter and trade rules are part of the key rather than applied at read
    time, because they change which stations the fill was allowed to see at all.

    What stays per ship - blocked stations, which wares it can actually carry, offer amounts - is
    applied by the caller against the returned offers, exactly as the MK1 pool applies its narrow
    basket at read time.

    A valid pool holding zero offers for the requested wares is a HIT with an empty list. That is
    the answer a live search would have produced, and escalating it to a miss would reintroduce the
    stampede this cache exists to remove.
  -->
  <params>
    <param name="refSector" default="null" comment="Sector the sell spaces were expanded from (pool identity)"/>
    <param name="maxSell" default="0" comment="Jump radius used for the fill"/>
    <param name="wares" default="[]" comment="Candidate wares wanted this cycle"/>
    <param name="variant" default="''" comment="Extra key discriminator when anchor+radius do not pin the sector set (e.g. 'n' + sellSpaces.count)"/>
    <param name="ownerFilter" default="'any'" comment="Owner restriction the fill used ('any' / 'player_only' / 'npc_only')"/>
    <param name="ignoreTradeRules" default="false"/>
    <param name="allowIllegal" default="false"/>
    <param name="maxAge" default="0s" comment="0 = take $Fleet.$CacheTTL"/>
    <param name="knownPoolKey" default="''" comment="Reuse an exact key instead of deriving one (post-write re-read)"/>
    <param name="debugchance" default="0"/>
  </params>
  <attention min="unknown">
    <actions>
      <!-- A re-read straight after a write passes back the key it wrote, so a derivation that
           disagreed could not silently discard the fill. -->
      <do_if value="$knownPoolKey != ''">
        <set_value name="$poolKey" exact="$knownPoolKey"/>
      </do_if>
      <do_else>
        <set_value name="$anchor" exact="if @$refSector != null and $refSector.exists then '' + $refSector.macro.id else 'nosec'"/>
        <set_value name="$poolKey" exact="'$' + $anchor + '|d' + $maxSell + (if $variant != '' then '|' + $variant else '') + '|o' + $ownerFilter + '|t' + (if $ignoreTradeRules then 1 else 0) + '|i' + (if $allowIllegal then 1 else 0)"/>
      </do_else>

      <set_value name="$miss" exact="table[
        $Hit = false,
        $Offers = [],
        $PoolKey = $poolKey,
        $Reason = 'empty',
        $Age = 0s,
        $CoveredWares = []
      ]"/>

      <do_if value="not global.$GT_TradeCacheMinerSell?">
        <return value="$miss"/>
      </do_if>
      <do_if value="typeof global.$GT_TradeCacheMinerSell != datatype.table">
        <return value="$miss"/>
      </do_if>
      <do_if value="not global.$GT_TradeCacheMinerSell.{$poolKey}?">
        <return value="$miss"/>
      </do_if>

      <set_value name="$pool" exact="global.$GT_TradeCacheMinerSell.{$poolKey}"/>
      <do_if value="typeof $pool != datatype.table">
        <return value="$miss"/>
      </do_if>

      <set_value name="$ttl" exact="300s"/>
      <do_if value="$maxAge? and $maxAge gt 0s">
        <set_value name="$ttl" exact="$maxAge"/>
      </do_if>
      <do_elseif value="global.$GT_GlobalSettings? and global.$GT_GlobalSettings.$Fleet?">
        <do_if value="global.$GT_GlobalSettings.$Fleet.$CacheTTL?">
          <set_value name="$ttl" exact="@global.$GT_GlobalSettings.$Fleet.$CacheTTL"/>
        </do_if>
      </do_elseif>

      <set_value name="$poolAt" exact="if $pool.$At != null then @$pool.$At else null"/>
      <do_if value="$poolAt == null">
        <return value="$miss"/>
      </do_if>
      <set_value name="$poolAge" exact="player.age - $poolAt"/>
      <do_if value="$poolAge gt $ttl">
        <set_value name="$miss.$Reason" exact="'expired'"/>
        <set_value name="$miss.$Age" exact="$poolAge"/>
        <return value="$miss"/>
      </do_if>

      <!-- Coverage: the fill must have searched every ware asked for now. On a coverage miss the
           caller unions $CoveredWares into its next fill basket so the two baskets converge instead
           of overwriting each other every cycle. -->
      <set_value name="$covered" exact="if $pool.$CoveredWares? then @$pool.$CoveredWares else []"/>
      <set_value name="$miss.$CoveredWares" exact="$covered"/>
      <set_value name="$coveredSet" exact="table[]"/>
      <do_all exact="$covered.count" counter="$cwi">
        <set_value name="$cw" exact="$covered.{$cwi}"/>
        <do_if value="@$cw != null">
          <set_value name="$coveredSet.{$cw}" exact="true"/>
        </do_if>
      </do_all>
      <set_value name="$wantedSet" exact="table[]"/>
      <do_all exact="$wares.count" counter="$wwi">
        <set_value name="$ww" exact="$wares.{$wwi}"/>
        <do_if value="@$ww != null">
          <do_if value="not $coveredSet.{$ww}?">
            <set_value name="$miss.$Reason" exact="'coverage'"/>
            <set_value name="$miss.$Age" exact="$poolAge"/>
            <debug_text text="'[GT-MinerSell] MISS coverage ware=' + (if $ww.name? then @$ww.name else '?') + ' key=' + $poolKey" chance="$debugchance"/>
            <return value="$miss"/>
          </do_if>
          <set_value name="$wantedSet.{$ww}" exact="true"/>
        </do_if>
      </do_all>

      <!-- Live fills inherit blacklist safety from the sell spaces; a cache read bypasses that
           expansion, so it must re-apply the filter itself. -->
      <set_value name="$blSet" exact="table[]"/>
      <do_if value="global.$GT_ThreatIntelligence?">
        <do_if value="global.$GT_ThreatIntelligence.$BlacklistedSectors?">
          <do_all exact="global.$GT_ThreatIntelligence.$BlacklistedSectors.count" counter="$bli">
            <set_value name="$blSector" exact="global.$GT_ThreatIntelligence.$BlacklistedSectors.{$bli}"/>
            <do_if value="@$blSector != null">
              <set_value name="$blSet.{$blSector}" exact="true"/>
            </do_if>
          </do_all>
        </do_if>
      </do_if>

      <create_list name="$hitOffers"/>
      <set_value name="$poolOffers" exact="if $pool.$Offers? then @$pool.$Offers else []"/>
      <set_value name="$droppedDead" exact="0"/>
      <set_value name="$droppedBl" exact="0"/>
      <do_all exact="$poolOffers.count" counter="$poi">
        <set_value name="$offer" exact="$poolOffers.{$poi}"/>
        <do_if value="@$offer == null">
          <set_value name="$droppedDead" operation="add"/>
          <continue/>
        </do_if>
        <do_if value="@$offer.ware == null">
          <set_value name="$droppedDead" operation="add"/>
          <continue/>
        </do_if>
        <do_if value="not $wantedSet.{$offer.ware}?">
          <continue/>
        </do_if>
        <do_if value="not $offer.available">
          <set_value name="$droppedDead" operation="add"/>
          <continue/>
        </do_if>
        <set_value name="$offerOwner" exact="@$offer.owner"/>
        <do_if value="$offerOwner == null or not $offerOwner.exists">
          <set_value name="$droppedDead" operation="add"/>
          <continue/>
        </do_if>
        <set_value name="$offerSector" exact="@$offerOwner.sector"/>
        <do_if value="$offerSector != null and $blSet.{$offerSector}?">
          <set_value name="$droppedBl" operation="add"/>
          <continue/>
        </do_if>
        <append_to_list name="$hitOffers" exact="$offer"/>
      </do_all>

      <debug_text text="'[GT-MinerSell] HIT offers=' + $hitOffers.count + '/' + $poolOffers.count + ' wares=' + $wares.count + ' age=' + $poolAge + ' dead=' + $droppedDead + ' blacklisted=' + $droppedBl + ' key=' + $poolKey" chance="$debugchance"/>

      <return value="table[
        $Hit = true,
        $Offers = $hitOffers,
        $PoolKey = $poolKey,
        $Reason = 'hit',
        $Age = $poolAge,
        $CoveredWares = $covered
      ]"/>
    </actions>
  </attention>
</aiscript>
