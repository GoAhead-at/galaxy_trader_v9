<?xml version="1.0" encoding="utf-8"?>
<aiscript name="lib.gt.miner_same_fleet" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../stock_game/X4 Foundations/libraries/aiscripts.xsd" version="1">
  <!--
    Non-blocking interrupt library: sets $fleetMatch (bool) from caller-scoped $shipA and $shipB.
    Named X4 fleet first; unfleeted Assist subordinates fall back to the same direct commander.
    Solo miners (no fleet name, no commander) only match themselves.
    Must not have blocking actions — use include_interrupt_actions instead of run_script in loops.

    Do NOT gate on $ship.fleet? / $cmdr.fleet? - those intermediates are not properties;
    only fleet.name / fleet.commander / fleet.iscommander exist (same fix as {FLEET} naming).
  -->
  <interrupts>
    <library>
      <actions name="MinerSameFleetMatch">
        <set_value name="$fleetMatch" exact="false"/>
        <do_if value="not $shipA? or not $shipA.exists or not $shipB? or not $shipB.exists">
          <return/>
        </do_if>
        <do_if value="$shipA == $shipB">
          <set_value name="$fleetMatch" exact="true"/>
          <return/>
        </do_if>
        <set_value name="$fleetKeyA" exact="null"/>
        <set_value name="$fleetKeyB" exact="null"/>
        <set_value name="$fleetCmdrA" exact="@$shipA.fleet.commander"/>
        <do_if value="$fleetCmdrA != null">
          <set_value name="$fleetNameA" exact="@$fleetCmdrA.fleet.name"/>
          <do_if value="$fleetNameA != null and $fleetNameA != ''">
            <set_value name="$fleetKeyA" exact="$fleetNameA"/>
          </do_if>
        </do_if>
        <do_if value="not $fleetKeyA?">
          <set_value name="$ownFleetNameA" exact="@$shipA.fleet.name"/>
          <do_if value="$ownFleetNameA != null and $ownFleetNameA != ''">
            <set_value name="$fleetKeyA" exact="$ownFleetNameA"/>
          </do_if>
        </do_if>
        <do_if value="not $fleetKeyA? and $shipA.commander? and $shipA.commander.exists and $shipA.commander != $shipA">
          <set_value name="$fleetKeyA" exact="$shipA.commander"/>
        </do_if>
        <set_value name="$fleetCmdrB" exact="@$shipB.fleet.commander"/>
        <do_if value="$fleetCmdrB != null">
          <set_value name="$fleetNameB" exact="@$fleetCmdrB.fleet.name"/>
          <do_if value="$fleetNameB != null and $fleetNameB != ''">
            <set_value name="$fleetKeyB" exact="$fleetNameB"/>
          </do_if>
        </do_if>
        <do_if value="not $fleetKeyB?">
          <set_value name="$ownFleetNameB" exact="@$shipB.fleet.name"/>
          <do_if value="$ownFleetNameB != null and $ownFleetNameB != ''">
            <set_value name="$fleetKeyB" exact="$ownFleetNameB"/>
          </do_if>
        </do_if>
        <do_if value="not $fleetKeyB? and $shipB.commander? and $shipB.commander.exists and $shipB.commander != $shipB">
          <set_value name="$fleetKeyB" exact="$shipB.commander"/>
        </do_if>
        <do_if value="$fleetKeyA? and $fleetKeyB? and $fleetKeyA == $fleetKeyB">
          <set_value name="$fleetMatch" exact="true"/>
        </do_if>
        <remove_value name="$fleetKeyA"/>
        <remove_value name="$fleetKeyB"/>
        <do_if value="$fleetCmdrA?"><remove_value name="$fleetCmdrA"/></do_if>
        <do_if value="$fleetNameA?"><remove_value name="$fleetNameA"/></do_if>
        <do_if value="$ownFleetNameA?"><remove_value name="$ownFleetNameA"/></do_if>
        <do_if value="$fleetCmdrB?"><remove_value name="$fleetCmdrB"/></do_if>
        <do_if value="$fleetNameB?"><remove_value name="$fleetNameB"/></do_if>
        <do_if value="$ownFleetNameB?"><remove_value name="$ownFleetNameB"/></do_if>
      </actions>
    </library>
  </interrupts>
</aiscript>
