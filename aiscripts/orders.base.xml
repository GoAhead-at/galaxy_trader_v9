<?xml version="1.0" encoding="utf-8"?>
<diff>

  <!-- Prevent undocking for GalaxyTrader dock-wrapper orders -->
  <add sel="//aiscript[@name='orders.base']/attention/actions/do_if[@value='$undock?']" pos="before">
    <do_if value="global.$GT_ReturnHomeHold? and global.$GT_ReturnHomeHold.{$object}? and global.$GT_ReturnHomeHoldUntil? and global.$GT_ReturnHomeHoldUntil.{$object}? and player.age ge global.$GT_ReturnHomeHoldUntil.{$object}">
      <remove_value name="global.$GT_ReturnHomeHold.{$object}"/>
      <remove_value name="global.$GT_ReturnHomeHoldUntil.{$object}"/>
    </do_if>
    <do_if value="global.$GT_IdleParkingHold? and global.$GT_IdleParkingHold.{$object}? and global.$GT_IdleParkingHoldUntil? and global.$GT_IdleParkingHoldUntil.{$object}? and player.age ge global.$GT_IdleParkingHoldUntil.{$object}">
      <remove_value name="global.$GT_IdleParkingHold.{$object}"/>
      <remove_value name="global.$GT_IdleParkingHoldUntil.{$object}"/>
    </do_if>
    <!-- Mirror vanilla DockAt/DockAndWait: hold dock only when already at the wrapper target.
         Blanket blocking prevented undock after trades when academy/training DockAndWait
         needed to leave the trade station and fly to the training station. -->
    <set_value name="$gtHoldUndockForWrapper" exact="false"/>
    <set_value name="$gtWrapperDest" exact="null"/>
    <do_if value="$object.order?">
      <do_if value="$object.order.id == 'DockAndTrain' or $object.order.id == 'DockAndReturnHome' or $object.order.id == 'DockAndPilotExchange'">
        <do_if value="$object.order.$destination?">
          <set_value name="$gtWrapperDest" exact="$object.order.$destination"/>
        </do_if>
      </do_if>
      <do_elseif value="$object.order.id == 'DockAndWait' and $object.order.$callerid?">
        <do_if value="@$object.order.$callerid.id == 'DockAndReturnHome' or @$object.order.$callerid.id == 'DockAndTrain' or @$object.order.$callerid.id == 'DockAndPilotExchange' or @$object.order.$callerid.id == 'GTIdlePark'">
          <do_if value="$object.order.$destination?">
            <set_value name="$gtWrapperDest" exact="$object.order.$destination"/>
          </do_if>
        </do_if>
      </do_elseif>
    </do_if>
    <do_if value="$gtWrapperDest? and @$gtWrapperDest.exists">
      <do_if value="$object.dock? and @$object.dock.container == $gtWrapperDest">
        <set_value name="$gtHoldUndockForWrapper" exact="true"/>
      </do_if>
      <do_elseif value="$object.parkedat? and (($object.parkedat == $gtWrapperDest) or @$object.parkedat.hascontext.{$gtWrapperDest})">
        <set_value name="$gtHoldUndockForWrapper" exact="true"/>
      </do_elseif>
    </do_if>
    <!-- Return-home hold keeps MK1 parked between cycles. It must not block a player order:
         once the live order is no longer MK1 or the return-home wrapper, drop the hold and launch. -->
    <set_value name="$gtReturnHomeOrder" exact="false"/>
    <do_if value="$object.order?">
      <do_if value="$object.order.id == 'GalaxyTraderMK1' or $object.order.id == 'DockAndReturnHome'">
        <set_value name="$gtReturnHomeOrder" exact="true"/>
      </do_if>
      <do_elseif value="$object.order.id == 'DockAndWait'">
        <do_if value="$object.order.$callerid?">
          <do_if value="@$object.order.$callerid.id == 'DockAndReturnHome'">
            <set_value name="$gtReturnHomeOrder" exact="true"/>
          </do_if>
        </do_if>
      </do_elseif>
      <do_elseif value="$object.order.id == 'Assist'">
        <set_value name="$gtMk1CommanderOrder" exact="null"/>
        <do_if value="@$object.commander.exists">
          <do_if value="$object.commander != $object">
            <do_if value="$object.commander.defaultorder?">
              <set_value name="$gtMk1CommanderOrder" exact="$object.commander.defaultorder"/>
              <do_if value="$gtMk1CommanderOrder.id == 'Assist'">
                <do_if value="$gtMk1CommanderOrder.$baseorder?">
                  <set_value name="$gtMk1CommanderOrder" exact="$gtMk1CommanderOrder.$baseorder"/>
                </do_if>
              </do_if>
            </do_if>
          </do_if>
        </do_if>
        <do_if value="$gtMk1CommanderOrder != null">
          <do_if value="$gtMk1CommanderOrder.id == 'GalaxyTraderMK1'">
            <set_value name="$gtReturnHomeOrder" exact="true"/>
          </do_if>
        </do_if>
      </do_elseif>
    </do_if>
    <set_value name="$gtReturnHomeBlocksUndock" exact="false"/>
    <do_if value="global.$GT_ReturnHomeHold? and global.$GT_ReturnHomeHold.{$object}?">
      <do_if value="$gtReturnHomeOrder">
        <do_if value="$object.order.id == 'GalaxyTraderMK1' or $object.order.id == 'Assist'">
          <set_value name="$gtReturnHomeBlocksUndock" exact="true"/>
        </do_if>
      </do_if>
      <do_else>
        <remove_value name="global.$GT_ReturnHomeHold.{$object}"/>
        <do_if value="global.$GT_ReturnHomeHoldUntil? and global.$GT_ReturnHomeHoldUntil.{$object}?">
          <remove_value name="global.$GT_ReturnHomeHoldUntil.{$object}"/>
        </do_if>
        <do_if value="global.$GT_MK1DockedSince? and global.$GT_MK1DockedSince.{$object}?">
          <remove_value name="global.$GT_MK1DockedSince.{$object}"/>
        </do_if>
        <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
          <debug_text text="'[GT ORDER PATCH] Released return-home hold for player order on ship: ' + $object.knownname + ' order=' + @$object.order.id" chance="if $object.isplayerowned then 100 else 0"/>
        </do_if>
      </do_else>
    </do_if>
    <do_if value="@$undock and ($gtReturnHomeBlocksUndock or (global.$GT_IdleParkingHold? and global.$GT_IdleParkingHold.{$object}? and (not global.$GT_IdleParkingHoldUntil? or not global.$GT_IdleParkingHoldUntil.{$object}? or player.age lt global.$GT_IdleParkingHoldUntil.{$object})) or $gtHoldUndockForWrapper)">
      <remove_value name="$undock"/>
      <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
        <debug_text text="'[GT ORDER PATCH] Preventing undock for GT dock wrapper order on ship: ' + $object.knownname + ' order=' + @$object.order.id" chance="if $object.isplayerowned then 100 else 0"/>
      </do_if>
    </do_if>
  </add>

</diff>
