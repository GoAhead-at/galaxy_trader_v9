<?xml version="1.0" encoding="utf-8"?>
<aiscript name="lib.gt.mk1.cache.write" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../stock_game/X4 Foundations/libraries/aiscripts.xsd" version="1">
  <!--
    MK1 offer-cache write. Called only by a ship holding an MK1 live slot, so there is never a
    second writer for the same pool key.

    The pool key is produced by lib.gt.mk1.cache.search and handed back in, so read and write can
    never disagree about pool identity. $CoveredWares records the ware superset the fill actually
    searched; the reader requires its narrow basket to be inside it.

    global.$GT_TradeCacheMK1Keys is a parallel key list: the pool table is keyed by composite
    strings, which table.keys does not enumerate reliably, and it bounds how many pools a save
    can accumulate after repeated setting changes.
  -->
  <params>
    <param name="poolKey" default="''" comment="Key returned by lib.gt.mk1.cache.search"/>
    <param name="side" default="'supply'"/>
    <param name="homeStation" default="null"/>
    <param name="offers" default="[]" comment="Offers returned by the live search"/>
    <param name="coverWares" default="[]" comment="Ware superset this fill searched"/>
    <param name="maxSell" default="0"/>
    <param name="buyPriceMin" default="0"/>
    <param name="sellPriceMax" default="0"/>
    <param name="ignoreTradeRules" default="false"/>
    <param name="allowIllegal" default="false"/>
    <param name="debugchance" default="0"/>
  </params>
  <attention min="unknown">
    <actions>
      <do_if value="$poolKey == ''">
        <return value="false"/>
      </do_if>

      <do_if value="not global.$GT_TradeCacheMK1?">
        <set_value name="global.$GT_TradeCacheMK1" exact="table[]"/>
      </do_if>
      <do_elseif value="typeof global.$GT_TradeCacheMK1 != datatype.table">
        <set_value name="global.$GT_TradeCacheMK1" exact="table[]"/>
      </do_elseif>
      <do_if value="not global.$GT_TradeCacheMK1Keys?">
        <set_value name="global.$GT_TradeCacheMK1Keys" exact="[]"/>
      </do_if>

      <!-- Memory guard only. lib.gt.live.search already caps at maxOffersPerWare (20), so a real
           MK1 basket stays far below this; tripping it means the basket grew unexpectedly wide. -->
      <set_value name="$maxOffers" exact="400"/>
      <do_if value="global.$GT_GlobalSettings? and global.$GT_GlobalSettings.$Performance?">
        <do_if value="global.$GT_GlobalSettings.$Performance.$CacheQueryMaxEntries?">
          <set_value name="$maxOffers" exact="(@global.$GT_GlobalSettings.$Performance.$CacheQueryMaxEntries) * 2"/>
        </do_if>
      </do_if>

      <create_list name="$storeOffers"/>
      <set_value name="$capped" exact="false"/>
      <do_all exact="$offers.count" counter="$woi">
        <do_if value="$storeOffers.count ge $maxOffers">
          <set_value name="$capped" exact="true"/>
          <break/>
        </do_if>
        <set_value name="$wOffer" exact="$offers.{$woi}"/>
        <do_if value="@$wOffer == null">
          <continue/>
        </do_if>
        <do_if value="@$wOffer.ware == null">
          <continue/>
        </do_if>
        <do_if value="not $wOffer.available">
          <continue/>
        </do_if>
        <append_to_list name="$storeOffers" exact="$wOffer"/>
      </do_all>

      <create_list name="$storeCover"/>
      <do_all exact="$coverWares.count" counter="$wci">
        <set_value name="$cWare" exact="$coverWares.{$wci}"/>
        <do_if value="@$cWare != null">
          <append_to_list name="$storeCover" exact="$cWare"/>
        </do_if>
      </do_all>

      <set_value name="$isNewKey" exact="not global.$GT_TradeCacheMK1.{$poolKey}?"/>
      <set_value name="global.$GT_TradeCacheMK1.{$poolKey}" exact="table[
        $At = player.age,
        $Side = $side,
        $HomeStation = $homeStation,
        $MaxSell = $maxSell,
        $BuyPriceMin = $buyPriceMin,
        $SellPriceMax = $sellPriceMax,
        $IgnoreTR = $ignoreTradeRules,
        $AllowIllegal = $allowIllegal,
        $CoveredWares = $storeCover,
        $Offers = $storeOffers
      ]"/>

      <do_if value="$isNewKey">
        <append_to_list name="global.$GT_TradeCacheMK1Keys" exact="$poolKey"/>
        <!-- Bound pool count: evict the oldest key (and its pool) once past the limit. -->
        <do_while value="global.$GT_TradeCacheMK1Keys.count gt 64">
          <set_value name="$evictKey" exact="global.$GT_TradeCacheMK1Keys.{1}"/>
          <remove_value name="global.$GT_TradeCacheMK1Keys.{1}"/>
          <do_if value="global.$GT_TradeCacheMK1.{$evictKey}?">
            <remove_value name="global.$GT_TradeCacheMK1.{$evictKey}"/>
          </do_if>
          <debug_text text="'[GT-MK1Cache] Evicted oldest pool key=' + $evictKey" chance="$debugchance"/>
        </do_while>
      </do_if>

      <debug_text text="'[GT-MK1Cache] WRITE side=' + $side + ' offers=' + $storeOffers.count + '/' + $offers.count + ' cover=' + $storeCover.count + (if $capped then ' CAPPED' else '') + ' pools=' + global.$GT_TradeCacheMK1Keys.count + ' key=' + $poolKey" chance="$debugchance"/>
      <return value="true"/>
    </actions>
  </attention>
</aiscript>
