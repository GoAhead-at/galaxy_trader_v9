<?xml version="1.0" encoding="utf-8"?>
<aiscript name="lib.gt.miner_sectors_inrange" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../stock_game/X4 Foundations/libraries/aiscripts.xsd" version="3">
  <!--
    Cached wrapper around vanilla lib.find.sectors.inrange for Galaxy Miner.

    Storage: global.$GT_MinerSectorCache keyed by fingerprint
      ref sector macro id + maxgate + stat.sectors_discovered + GT_BlacklistEpoch + effective blacklist
      (group, commander sector and the blacklisted sectors in range, or 'nobl')
    Shared across ships whose blacklists agree on the range. Soft TTL 300s. Reset whenever the
    discovery count or blacklist epoch changes (global.$GT_MinerSectorCacheGen).

    On MISS: one vanilla BFS for the requested radius. Do not derive smaller radii
    from its outward distances: vanilla also validates return distance and policy.
    Vanilla debugchance is forced to 0; the cache's HIT/MISS line is sufficient.

    Single-flight: if another ship is filling the same key, wait and reuse.
    Writes this.$gtMinerSectorsResult for callers that must avoid result=.
  -->
  <params>
    <param name="refobject" default="null" comment="Sector or object with .sector used as BFS center"/>
    <param name="maxgatedistance" default="0" comment="Max gate distance (mingate always 0 for GT Miner)"/>
    <param name="ttl" default="300s" comment="Soft max age of a cache entry"/>
    <param name="debugchance" default="0"/>
  </params>
  <attention min="unknown">
    <actions>
      <set_value name="$ship" exact="this.assignedcontrolled"/>
      <create_list name="$emptyResult"/>
      <set_value name="this.$gtMinerSectorsResult" exact="$emptyResult"/>
      <do_if value="not $ship? or not $ship.exists">
        <return value="$emptyResult"/>
      </do_if>

      <set_value name="$refsector" exact="null"/>
      <do_if value="$refobject? and $refobject.exists and $refobject.isclass.sector">
        <set_value name="$refsector" exact="$refobject"/>
      </do_if>
      <do_elseif value="$refobject? and $refobject.exists and $refobject.sector?">
        <set_value name="$refsector" exact="@$refobject.sector"/>
      </do_elseif>
      <do_if value="not $refsector? or not $refsector.exists">
        <debug_text text="'[GT-Miner] ' + $ship.idcode + ': sector-cache abort (no ref sector)'" chance="$debugchance"/>
        <return value="$emptyResult"/>
      </do_if>

      <set_value name="$refId" exact="'$' + $refsector.macro.id"/>
      <set_value name="$maxGate" exact="$maxgatedistance"/>
      <set_value name="$disc" exact="0"/>
      <do_if value="@stat.sectors_discovered != null">
        <set_value name="$disc" exact="stat.sectors_discovered"/>
      </do_if>
      <set_value name="$blEpoch" exact="0"/>
      <do_if value="global.$GT_BlacklistEpoch?">
        <set_value name="$blEpoch" exact="global.$GT_BlacklistEpoch"/>
      </do_if>
      <set_value name="$ttlSafe" exact="if $ttl? and $ttl gt 0s then $ttl else 300s"/>

      <!-- Entries from an older discovery count or blacklist epoch can never be read again: drop the
           whole table when either changes instead of letting dead keys accumulate. -->
      <set_value name="$cacheGen" exact="'' + $disc + '.' + $blEpoch"/>
      <do_if value="not global.$GT_MinerSectorCache? or typeof global.$GT_MinerSectorCache != datatype.table or @global.$GT_MinerSectorCacheGen != $cacheGen">
        <set_value name="global.$GT_MinerSectorCache" exact="table[]"/>
        <set_value name="global.$GT_MinerSectorCacheGen" exact="$cacheGen"/>
      </do_if>

      <!-- Vanilla's result depends on the calling ship. Without a sector blacklist it takes the
           unfiltered branch, the same answer for every ship. With one, the answer depends only on which
           sectors in the in-range clusters that blacklist marks (a path of at most maxgate jumps never
           leaves them), the group, and the commander's sector (always allowed). Script cannot read which
           blacklist a ship is assigned, so the key carries those marks instead: ships whose blacklists
           agree on this range share an entry, and any two that differ get different keys. -->
      <include_interrupt_actions ref="GetBlacklistgroup"/>
      <set_value name="$mscGroup" exact="if $blacklistgroup? then $blacklistgroup else null"/>
      <set_value name="$mscHasBL" exact="false"/>
      <do_if value="$mscGroup != null">
        <set_value name="$mscHasBL" exact="$ship.hasblacklist.{blacklisttype.sectoractivity}.{$mscGroup} or $ship.hasblacklist.{blacklisttype.sectortravel}.{$mscGroup}"/>
      </do_if>
      <set_value name="$policy" exact="(if this.isplayerowned then 'p' else 'n') + '.nobl'"/>
      <do_if value="$mscHasBL">
        <set_value name="$policy" exact="(if this.isplayerowned then 'p' else 'n') + '.' + $mscGroup + '.c' + (if @$ship.commander.sector then $ship.commander.sector.macro.id else 'none') + '.'"/>
        <find_cluster_in_range distances="$mscClusters" multiple="true" object="$refsector" mindistance="0" maxdistance="$maxGate"/>
        <do_for_each name="$mscCluster" in="$mscClusters">
          <find_sector name="$mscSectors" space="$mscCluster" multiple="true"/>
          <do_for_each name="$mscSec" in="$mscSectors">
            <do_if value="$mscSec.isblacklisted.{blacklisttype.sectoractivity}.{$mscGroup}.{$ship}">
              <set_value name="$policy" exact="$policy + 'a' + $mscSec.macro.id"/>
            </do_if>
            <do_if value="$mscSec.isblacklisted.{blacklisttype.sectortravel}.{$mscGroup}.{$ship}">
              <set_value name="$policy" exact="$policy + 't' + $mscSec.macro.id"/>
            </do_if>
          </do_for_each>
        </do_for_each>
        <remove_value name="$mscClusters"/>
        <remove_value name="$mscSectors"/>
      </do_if>
      <set_value name="$cacheKey" exact="$refId + '.' + $maxGate + '.' + $disc + '.' + $blEpoch + '.' + $policy"/>

      <!-- Fast HIT path (no yield). -->
      <do_if value="global.$GT_MinerSectorCache.{$cacheKey}? and typeof global.$GT_MinerSectorCache.{$cacheKey} == datatype.table">
        <set_value name="$entry" exact="global.$GT_MinerSectorCache.{$cacheKey}"/>
        <do_if value="$entry.$Spaces? and $entry.$At? and (player.age - $entry.$At) le $ttlSafe">
          <set_value name="$result" exact="$entry.$Spaces.clone"/>
          <set_value name="this.$gtMinerSectorsResult" exact="$result"/>
          <debug_text text="'[GT-Miner] ' + $ship.idcode + ': sector-cache HIT count=' + $result.count + ' maxgate=' + $maxGate + ' disc=' + $disc + ' key=' + $cacheKey" chance="$debugchance"/>
          <return value="$result"/>
        </do_if>
      </do_if>

      <!-- Persist across single-flight waits (locals die on yield). -->
      <set_value name="this.$gtMscKey" exact="$cacheKey"/>
      <set_value name="this.$gtMscRef" exact="$refsector"/>
      <set_value name="this.$gtMscRefId" exact="$refId"/>
      <set_value name="this.$gtMscMax" exact="$maxGate"/>
      <set_value name="this.$gtMscDisc" exact="$disc"/>
      <set_value name="this.$gtMscBL" exact="$blEpoch"/>
      <set_value name="this.$gtMscPolicy" exact="$policy"/>
      <set_value name="this.$gtMscTtl" exact="$ttlSafe"/>
      <set_value name="this.$gtMscWaitLeft" exact="12"/>
      <set_value name="this.$gtMscClaimed" exact="false"/>
      <set_value name="this.$gtMscHit" exact="null"/>

      <!-- Single-flight: wait while another ship builds this exact key, otherwise claim it.
           Active builds are a list of table[$Key, $At], not a single key. A scalar only ever holds
           one key, so a second ref sector starting a build silently unlocked the first and let a
           third ship duplicate a build already in progress - the exclusion only held while the
           whole fleet shared one key. Entries carry a timestamp and are pruned once stale, so an
           order torn down mid-build releases on its own and no counter can leak.
           Poll slowly and with jitter: a 1ms poll is one script wake per frame per waiter, and a
           fleet hits the same key in the same frame, so the polling cost scaled with fleet size. -->
      <do_while value="not this.$gtMscClaimed and this.$gtMscHit == null and this.$gtMscWaitLeft gt 0">
        <do_if value="not global.$GT_MinerSectorBfsFills? or typeof global.$GT_MinerSectorBfsFills != datatype.list">
          <set_value name="global.$GT_MinerSectorBfsFills" exact="[]"/>
        </do_if>
        <set_value name="$mineLocked" exact="false"/>
        <do_all exact="global.$GT_MinerSectorBfsFills.count" counter="$bfi" reverse="true">
          <set_value name="$bfsEntry" exact="global.$GT_MinerSectorBfsFills.{$bfi}"/>
          <do_if value="$bfsEntry? and $bfsEntry.$At? and (player.age - @$bfsEntry.$At) lt 10s">
            <do_if value="$bfsEntry.$Key? and @$bfsEntry.$Key == this.$gtMscKey">
              <set_value name="$mineLocked" exact="true"/>
            </do_if>
          </do_if>
          <do_else>
            <remove_value name="global.$GT_MinerSectorBfsFills.{$bfi}"/>
          </do_else>
        </do_all>

        <do_if value="not $mineLocked">
          <append_to_list name="global.$GT_MinerSectorBfsFills" exact="table[$Key = this.$gtMscKey, $At = player.age]"/>
          <set_value name="this.$gtMscClaimed" exact="true"/>
        </do_if>
        <do_else>
          <wait min="150ms" max="350ms"/>
          <set_value name="this.$gtMscWaitLeft" exact="this.$gtMscWaitLeft - 1"/>
          <!-- The holder may have published this exact radius and policy. -->
          <do_if value="global.$GT_MinerSectorCache.{this.$gtMscKey}? and typeof global.$GT_MinerSectorCache.{this.$gtMscKey} == datatype.table">
            <set_value name="$entry" exact="global.$GT_MinerSectorCache.{this.$gtMscKey}"/>
            <do_if value="$entry.$Spaces? and $entry.$At? and (player.age - $entry.$At) le this.$gtMscTtl">
              <set_value name="this.$gtMscHit" exact="$entry"/>
            </do_if>
          </do_if>
        </do_else>
      </do_while>

      <!-- Timed out behind the holder: reuse the expired entry for this key instead of running the
           same BFS a second time while the holder is still building it. -->
      <do_if value="not this.$gtMscClaimed and this.$gtMscHit == null and typeof @global.$GT_MinerSectorCache.{this.$gtMscKey} == datatype.table and @global.$GT_MinerSectorCache.{this.$gtMscKey}.$Spaces != null">
        <set_value name="this.$gtMscHit" exact="global.$GT_MinerSectorCache.{this.$gtMscKey}"/>
      </do_if>

      <!-- Took a peer's result: nothing was claimed, so there is nothing to release. -->
      <do_if value="this.$gtMscHit != null">
        <set_value name="$result" exact="this.$gtMscHit.$Spaces.clone"/>
        <set_value name="this.$gtMinerSectorsResult" exact="$result"/>
        <debug_text text="'[GT-Miner] ' + this.assignedcontrolled.idcode + ': sector-cache HIT-after-wait count=' + $result.count + ' key=' + this.$gtMscKey" chance="$debugchance"/>
        <remove_value name="this.$gtMscKey"/>
        <remove_value name="this.$gtMscRef"/>
        <remove_value name="this.$gtMscRefId"/>
        <remove_value name="this.$gtMscMax"/>
        <remove_value name="this.$gtMscDisc"/>
        <remove_value name="this.$gtMscBL"/>
        <remove_value name="this.$gtMscPolicy"/>
        <remove_value name="this.$gtMscTtl"/>
        <remove_value name="this.$gtMscWaitLeft"/>
        <remove_value name="this.$gtMscClaimed"/>
        <remove_value name="this.$gtMscHit"/>
        <return value="$result"/>
      </do_if>

      <!-- Waited out the budget on a key that has never been built. Build anyway rather than returning
           nothing; the release path keys off this entry, so claiming keeps the release symmetric. -->
      <do_if value="not this.$gtMscClaimed">
        <append_to_list name="global.$GT_MinerSectorBfsFills" exact="table[$Key = this.$gtMscKey, $At = player.age]"/>
      </do_if>

      <!-- Distance table for this exact radius and blacklist fingerprint. -->
      <run_script name="'lib.find.sectors.inrange'" result="$sectorTable">
        <param name="refobject" value="this.$gtMscRef"/>
        <param name="mingatedistance" value="0"/>
        <param name="maxgatedistance" value="this.$gtMscMax"/>
        <param name="returndistancetable" value="true"/>
        <param name="debugchance" value="0"/>
      </run_script>
      <do_if value="not $sectorTable? or typeof $sectorTable != datatype.table">
        <set_value name="$sectorTable" exact="table[]"/>
      </do_if>
      <do_if value="this.assignedcontrolled.isplayerowned and this.$gtMscMax le 0 and this.$gtMscRef.isclass.sector and not $sectorTable.{this.$gtMscRef}?">
        <set_value name="$sectorTable.{this.$gtMscRef}" exact="0"/>
      </do_if>

      <!-- Vanilla validates both outward and return distance. Its distance table records only
           the outward leg, so deriving smaller-radius entries here is not sound. -->
      <create_list name="$requestedSpaces"/>
      <do_for_each name="$sec" valuename="$dist" in="$sectorTable">
        <do_if value="@$sec.exists and $dist ge 0 and $dist le this.$gtMscMax">
          <append_to_list name="$requestedSpaces" exact="$sec"/>
        </do_if>
      </do_for_each>
      <set_value name="global.$GT_MinerSectorCache.{this.$gtMscKey}" exact="table[$Spaces = $requestedSpaces.clone, $At = player.age]"/>

      <set_value name="this.$gtMinerSectorsResult" exact="$requestedSpaces"/>

      <!-- Release this key so waiters stop polling. Only the first match is dropped: a waiter that
           timed out may hold a second entry for the same key and still owns it. -->
      <do_if value="global.$GT_MinerSectorBfsFills? and typeof global.$GT_MinerSectorBfsFills == datatype.list">
        <set_value name="$released" exact="false"/>
        <do_all exact="global.$GT_MinerSectorBfsFills.count" counter="$rbi" reverse="true">
          <do_if value="not $released">
            <set_value name="$relEntry" exact="global.$GT_MinerSectorBfsFills.{$rbi}"/>
            <do_if value="$relEntry? and $relEntry.$Key? and @$relEntry.$Key == this.$gtMscKey">
              <remove_value name="global.$GT_MinerSectorBfsFills.{$rbi}"/>
              <set_value name="$released" exact="true"/>
            </do_if>
          </do_if>
        </do_all>
      </do_if>

      <debug_text text="'[GT-Miner] ' + this.assignedcontrolled.idcode + ': sector-cache MISS count=' + $requestedSpaces.count + ' maxgate=' + this.$gtMscMax + ' disc=' + this.$gtMscDisc + ' bl=' + this.$gtMscBL + ' key=' + this.$gtMscKey" chance="$debugchance"/>

      <remove_value name="this.$gtMscKey"/>
      <remove_value name="this.$gtMscRef"/>
      <remove_value name="this.$gtMscRefId"/>
      <remove_value name="this.$gtMscMax"/>
      <remove_value name="this.$gtMscDisc"/>
      <remove_value name="this.$gtMscBL"/>
      <remove_value name="this.$gtMscPolicy"/>
      <remove_value name="this.$gtMscTtl"/>
      <remove_value name="this.$gtMscWaitLeft"/>
      <remove_value name="this.$gtMscClaimed"/>
      <remove_value name="this.$gtMscHit"/>

      <return value="$requestedSpaces"/>
    </actions>
  </attention>
</aiscript>
