<?xml version="1.0" encoding="utf-8"?>
<aiscript name="lib.gt.miner.sell.claim" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../stock_game/X4 Foundations/libraries/aiscripts.xsd" version="1">
  <!--
    Fill slot for the Galaxy Miner overflow sell cache. Called only after
    lib.gt.miner.sell.search returned a miss; lib.gt.miner.sell.write releases the slot.

    On a cold pool every miner sharing a mining range would otherwise run the same 27-136 sector
    live search in the same frame, which is the stampede the cache exists to remove. The first
    caller claims the slot and is told to fill; the rest poll briefly and are told a peer published,
    at which point the caller re-reads the cache with the same pool key. A waiter that times out on a
    pool filled earlier gets $Stale = true and re-reads it with allowExpired instead of searching.

    Two guarantees come out of one structure:
      1. At most one fill per pool key, so a range is never scanned twice at once.
      2. At most 3 fills galaxy-wide, so many distinct ranges cannot all scan at once.
    Entries retain their owner and claim key until completion or interruption. A slow live scan
    cannot lose its slot merely because it exceeded a timer.

    The library keeps the bounded polling protocol in one place for both miner callers.
  -->
  <params>
    <param name="poolKey" default="''"/>
    <param name="maxAge" default="300s" comment="Same TTL the reader used, for the published-while-waiting check"/>
    <param name="wares" default="[]" comment="Fill basket the caller will re-read with; a published pool only counts as a hit when it covers all of them"/>
    <param name="debugchance" default="0"/>
  </params>
  <attention min="unknown">
    <actions>
      <do_if value="$poolKey == ''">
        <return value="table[$Claimed = false, $Hit = false]"/>
      </do_if>

      <!-- Publish claim state for the writer and order interruption cleanup. -->
      <set_value name="this.$gtMscKey" exact="$poolKey"/>
      <set_value name="this.$gtMscTtl" exact="if $maxAge? and $maxAge gt 0s then $maxAge else 300s"/>
      <set_value name="this.$gtMscDebug" exact="$debugchance"/>
      <set_value name="this.$gtMscWaitLeft" exact="20"/>
      <set_value name="this.$gtMscClaimed" exact="false"/>
      <set_value name="this.$gtMscHit" exact="false"/>

      <!-- Active fills as a list of table[$Key, $At, $Owner]. A single scalar lock would only ever hold one
           key: a second pool starting a fill would silently unlock the first, letting a third ship
           duplicate a fill already in progress. A list also enumerates reliably, which a table keyed
           by these composite strings does not.
           Re-read the shared slot count each poll because peers may claim or release while we wait. -->
      <do_while value="not this.$gtMscClaimed and not this.$gtMscHit and this.$gtMscWaitLeft gt 0">
        <do_if value="not global.$GT_MinerSellFills? or typeof global.$GT_MinerSellFills != datatype.list">
          <set_value name="global.$GT_MinerSellFills" exact="[]"/>
        </do_if>
        <set_value name="$sellLocked" exact="false"/>
        <do_all exact="global.$GT_MinerSellFills.count" counter="$fki" reverse="true">
          <set_value name="$fillEntry" exact="global.$GT_MinerSellFills.{$fki}"/>
          <do_if value="@$fillEntry.$Owner.exists and @$fillEntry.$Owner.$gtMinerSellFillKey == @$fillEntry.$Key">
            <do_if value="$fillEntry.$Key? and @$fillEntry.$Key == this.$gtMscKey">
              <set_value name="$sellLocked" exact="true"/>
            </do_if>
          </do_if>
          <do_else>
            <remove_value name="global.$GT_MinerSellFills.{$fki}"/>
          </do_else>
        </do_all>

        <do_if value="not $sellLocked and global.$GT_MinerSellFills.count lt 3">
          <append_to_list name="global.$GT_MinerSellFills" exact="table[$Key = this.$gtMscKey, $At = player.age, $Owner = this]"/>
          <set_value name="this.$gtMscClaimed" exact="true"/>
          <set_value name="this.$gtMinerSellFillKey" exact="this.$gtMscKey"/>
        </do_if>
        <do_else>
          <wait min="150ms" max="350ms"/>
          <set_value name="this.$gtMscWaitLeft" exact="this.$gtMscWaitLeft - 1"/>
          <!-- The holder may have published while we waited. It only answers us if its fill covered our
               wares: otherwise the re-read coverage-misses and the caller would sell to nobody. Keep
               polling instead; the holder has released the key, so the next pass can claim it. -->
          <do_if value="global.$GT_TradeCacheMinerSell? and global.$GT_TradeCacheMinerSell.{this.$gtMscKey}?">
            <set_value name="$waitEntry" exact="global.$GT_TradeCacheMinerSell.{this.$gtMscKey}"/>
            <do_if value="typeof $waitEntry == datatype.table and $waitEntry.$At != null and (player.age - $waitEntry.$At) le this.$gtMscTtl">
              <set_value name="$waitCovered" exact="true"/>
              <do_if value="@$wares.count gt 0">
                <set_value name="$waitCover" exact="if $waitEntry.$CoveredWares? then @$waitEntry.$CoveredWares else []"/>
                <do_all exact="$wares.count" counter="$wcwi">
                  <do_if value="@$wares.{$wcwi} != null and not $waitCover.indexof.{$wares.{$wcwi}}">
                    <set_value name="$waitCovered" exact="false"/>
                    <break/>
                  </do_if>
                </do_all>
              </do_if>
              <do_if value="$waitCovered">
                <set_value name="this.$gtMscHit" exact="true"/>
              </do_if>
            </do_if>
          </do_if>
        </do_else>
      </do_while>

      <!-- Waited out the budget without a slot or a fresh result. If the pool was filled before, report
           it as an expired hit: every waiter would otherwise start its own search at once and the 3-fill
           cap would stop meaning anything under saturation. The caller re-reads with allowExpired, and
           lib.gt.miner.sell.search still drops dead, unavailable and blacklisted offers on that read. -->
      <set_value name="this.$gtMscStale" exact="false"/>
      <!-- Same age bound as the demand pool: 10 TTLs, at least 5 min. -->
      <do_if value="not this.$gtMscClaimed and not this.$gtMscHit and global.$GT_TradeCacheMinerSell? and typeof @global.$GT_TradeCacheMinerSell.{this.$gtMscKey} == datatype.table and @global.$GT_TradeCacheMinerSell.{this.$gtMscKey}.$At != null and (player.age - global.$GT_TradeCacheMinerSell.{this.$gtMscKey}.$At) le [this.$gtMscTtl * 10, 300s].max">
        <!-- Same coverage rule as above: an expired pool without our wares is no answer (deferred). -->
        <set_value name="$staleCovered" exact="true"/>
        <do_if value="@$wares.count gt 0">
          <set_value name="$staleCover" exact="if global.$GT_TradeCacheMinerSell.{this.$gtMscKey}.$CoveredWares? then @global.$GT_TradeCacheMinerSell.{this.$gtMscKey}.$CoveredWares else []"/>
          <do_all exact="$wares.count" counter="$scwi">
            <do_if value="@$wares.{$scwi} != null and not $staleCover.indexof.{$wares.{$scwi}}">
              <set_value name="$staleCovered" exact="false"/>
              <break/>
            </do_if>
          </do_all>
        </do_if>
        <do_if value="$staleCovered">
          <set_value name="this.$gtMscHit" exact="true"/>
          <set_value name="this.$gtMscStale" exact="true"/>
          <debug_text text="'[GT-MinerSell] Fill slots saturated - reusing expired pool key=' + this.$gtMscKey" chance="this.$gtMscDebug"/>
        </do_if>
      </do_if>

      <!-- A cold saturated pool is deferred. Never scan or publish without a fill slot. -->
      <set_value name="$outClaimed" exact="this.$gtMscClaimed"/>
      <set_value name="$outHit" exact="this.$gtMscHit"/>
      <set_value name="$outStale" exact="@this.$gtMscStale == true"/>
      <debug_text text="'[GT-MinerSell] CLAIM claimed=' + $outClaimed + ' peerPublished=' + $outHit + ' expired=' + $outStale + ' key=' + this.$gtMscKey" chance="this.$gtMscDebug"/>
      <remove_value name="this.$gtMscKey"/>
      <remove_value name="this.$gtMscTtl"/>
      <remove_value name="this.$gtMscDebug"/>
      <remove_value name="this.$gtMscWaitLeft"/>
      <remove_value name="this.$gtMscClaimed"/>
      <remove_value name="this.$gtMscHit"/>
      <remove_value name="this.$gtMscStale"/>
      <return value="table[$Claimed = $outClaimed, $Hit = $outHit, $Stale = $outStale, $Deferred = (not $outClaimed and not $outHit)]"/>
    </actions>
  </attention>
</aiscript>
