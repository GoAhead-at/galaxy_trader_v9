<?xml version="1.0" encoding="utf-8"?>
<mdscript name="GT_Context_Promote" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../stock_game/X4 Foundations/libraries/md.xsd">
  <cues>
    <!-- MD side of "Promote" (ui/gt_context_promote.lua). The menu entry is registered in
         GT_Context_Diagnose.AddDiagnoseAction together with the other GT ship actions. -->

    <!-- Handle when user clicks "Promote" on a GT subordinate -->
    <cue name="GT_PromoteSubordinateAction" instantiate="true" namespace="this">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$ship" exact="event.param.$object"/>
        <set_value name="$canRun" exact="true"/>
        <do_if value="not $ship? or not $ship.exists or not $ship.commander? or not $ship.commander.exists">
          <show_notification text="'[GT] Promote unavailable: no valid commander found.'" timeout="5s"/>
          <set_value name="$canRun" exact="false"/>
        </do_if>

        <do_if value="$canRun and @global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
          <debug_text text="'[GT Promote] Requested for subordinate ' + $ship.idcode + ' under commander ' + $ship.commander.idcode" chance="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging"/>
        </do_if>

        <do_if value="$canRun">
          <!-- Lua promotes subordinate to commander -->
          <raise_lua_event name="'gt.openPromoteContext'" param="$ship"/>
        </do_if>
      </actions>
    </cue>

    <!-- Promote under a station: give the promoted ship the old commander's GT order as its
         default and put it on the station, in one step. Lua's planned default can be refused
         by the ship's current order, and a queued AssignCommander asks the station for a
         vanilla default when it runs; both made the result depend on what the ship was doing.
         Lua continues with the rest of the fleet on gt.promoteStationStepDone. -->
    <cue name="GT_PromoteStationStep" instantiate="true" namespace="this">
      <conditions>
        <event_ui_triggered screen="'GT_Promote'" control="'StationStep'"/>
      </conditions>
      <actions>
        <set_value name="$p" exact="event.param3"/>
        <set_value name="$ship" exact="if $p? and $p.$ship? then $p.$ship else null"/>
        <set_value name="$source" exact="if $p? and $p.$source? then $p.$source else null"/>
        <set_value name="$cap" exact="if $p? and $p.$jumpCap? then $p.$jumpCap else 25"/>
        <set_value name="$station" exact="null"/>
        <set_value name="$orderId" exact="null"/>
        <set_value name="$done" exact="false"/>
        <do_if value="@$ship.exists and @$source.exists and $ship.isplayerowned">
          <set_value name="$station" exact="$source.commander"/>
          <set_value name="$src" exact="$source.defaultorder"/>
          <set_value name="$orderId" exact="@$src.id"/>
        </do_if>

        <do_if value="@$station.exists and (@$station.isclass.station or @$station.isclass.buildstorage) and $orderId != null">
          <set_value name="$assignment" exact="$source.assignment"/>
          <do_if value="$orderId == 'GalaxyMiner'">
            <create_order id="'GalaxyMiner'" object="$ship" default="true">
              <param name="homeStation" value="$src.$homeStation"/>
              <param name="homePosition" value="$src.$homePosition"/>
              <param name="homeSector" value="$src.$homeSector"/>
              <param name="resourceBasket" value="$src.$resourceBasket"/>
              <param name="stationList" value="$src.$stationList"/>
              <param name="blockedstations" value="$src.$blockedstations"/>
              <param name="overflowThreshold" value="$src.$overflowThreshold"/>
              <param name="allowOverflowSellToOthers" value="$src.$allowOverflowSellToOthers"/>
              <param name="assignToStation" value="$src.$assignToStation"/>
              <param name="playerStationsOnly" value="$src.$playerStationsOnly"/>
              <param name="checkDemandFirst" value="$src.$checkDemandFirst"/>
              <param name="allowillegal" value="$src.$allowillegal"/>
              <param name="enforceRouteIllegalLegality" value="$src.$enforceRouteIllegalLegality"/>
              <param name="stayAtHome" value="$src.$stayAtHome"/>
              <param name="idleParking" value="$src.$idleParking"/>
              <param name="autoJumpDistanceByLevel" value="$src.$autoJumpDistanceByLevel"/>
              <param name="maxCollectorDronesToBuy" value="$src.$maxCollectorDronesToBuy"/>
              <param name="maxGatherDistance" value="[$src.$maxGatherDistance, $cap].min"/>
              <param name="maxSellDistance" value="[$src.$maxSellDistance, $cap].min"/>
              <param name="fleetBalancing" value="$src.$fleetBalancing"/>
              <param name="demandRecheckInterval" value="$src.$demandRecheckInterval"/>
              <param name="physicalStorageAbortPercent" value="$src.$physicalStorageAbortPercent"/>
              <param name="criticalDemandDelta" value="$src.$criticalDemandDelta"/>
              <param name="minSwitchCooldown" value="$src.$minSwitchCooldown"/>
              <param name="minCargoCommitPercent" value="$src.$minCargoCommitPercent"/>
              <param name="hardEmergencyDelta" value="$src.$hardEmergencyDelta"/>
              <param name="notifications" value="$src.$notifications"/>
              <param name="logbookentries" value="$src.$logbookentries"/>
              <param name="debuglevel" value="$src.$debuglevel"/>
            </create_order>
          </do_if>
          <do_elseif value="$orderId == 'GalaxyTraderMK3'">
            <create_order id="'GalaxyTraderMK3'" object="$ship" default="true">
              <param name="home" value="$src.$home"/>
              <param name="maxbuy" value="[$src.$maxbuy, $cap].min"/>
              <param name="maxsell" value="[$src.$maxsell, $cap].min"/>
              <param name="allowillegal" value="$src.$allowillegal"/>
              <param name="enforceRouteIllegalLegality" value="$src.$enforceRouteIllegalLegality"/>
              <param name="ignorecarrieraux" value="$src.$ignorecarrieraux"/>
              <param name="ignorebuildstorage" value="$src.$ignorebuildstorage"/>
              <param name="ignoretraderules" value="$src.$ignoretraderules"/>
              <param name="ignoreplayerpricing" value="$src.$ignoreplayerpricing"/>
              <param name="ignoremk1supply" value="$src.$ignoremk1supply"/>
              <param name="logbookentries" value="$src.$logbookentries"/>
              <param name="idleParking" value="$src.$idleParking"/>
              <param name="autoJumpDistanceByLevel" value="$src.$autoJumpDistanceByLevel"/>
              <param name="factionpriority" value="$src.$factionpriority"/>
              <param name="autowares" value="$src.$autowares"/>
              <param name="warebasket" value="$src.$warebasket"/>
              <param name="sectorwhitelist" value="$src.$sectorwhitelist"/>
              <param name="blockedstations" value="$src.$blockedstations"/>
              <param name="priorityscoremultiplier" value="$src.$priorityscoremultiplier"/>
              <param name="prioritywares" value="$src.$prioritywares"/>
              <param name="distancepenalty" value="$src.$distancepenalty"/>
              <param name="notifications" value="$src.$notifications"/>
              <param name="fleetcoordination" value="$src.$fleetcoordination"/>
              <param name="cargotarget" value="$src.$cargotarget"/>
              <param name="marketupdatefreq" value="$src.$marketupdatefreq"/>
              <param name="debuglevel" value="$src.$debuglevel"/>
              <param name="tradeeval" value="$src.$tradeeval"/>
            </create_order>
          </do_elseif>
          <do_elseif value="$orderId == 'GalaxyTraderMK1'">
            <create_order id="'GalaxyTraderMK1'" object="$ship" default="true">
              <param name="homeStation" value="$src.$homeStation"/>
              <param name="maxsell" value="[$src.$maxsell, $cap].min"/>
              <param name="ignoretraderules" value="$src.$ignoretraderules"/>
              <param name="allowillegal" value="$src.$allowillegal"/>
              <param name="enforceRouteIllegalLegality" value="$src.$enforceRouteIllegalLegality"/>
              <param name="warebasket" value="$src.$warebasket"/>
              <param name="selltarget" value="$src.$selltarget"/>
              <param name="sellselectionmode" value="$src.$sellselectionmode"/>
              <param name="buytarget" value="$src.$buytarget"/>
              <param name="backtrackTolerance" value="$src.$backtrackTolerance"/>
              <param name="allowmultitrade" value="$src.$allowmultitrade"/>
              <param name="logbookentries" value="$src.$logbookentries"/>
              <param name="notifications" value="$src.$notifications"/>
              <param name="fleetcoordination" value="$src.$fleetcoordination"/>
              <param name="debuglevel" value="$src.$debuglevel"/>
              <param name="supply" value="$src.$supply"/>
              <param name="minstorage" value="$src.$minstorage"/>
              <param name="minsellstorage" value="$src.$minsellstorage"/>
              <param name="pricerange" value="$src.$pricerange"/>
              <param name="returnhome" value="$src.$returnhome"/>
              <param name="autoJumpDistanceByLevel" value="$src.$autoJumpDistanceByLevel"/>
            </create_order>
          </do_elseif>
          <do_elseif value="$orderId == 'GalaxyTraderMK2'">
            <create_order id="'GalaxyTraderMK2'" object="$ship" default="true">
              <param name="homeStation" value="$src.$homeStation"/>
              <param name="homeSector" value="$src.$homeSector"/>
              <param name="destList" value="$src.$destList"/>
              <param name="sourceList" value="$src.$sourceList"/>
              <param name="sourceStation" value="$src.$sourceStation"/>
              <param name="minStorage" value="$src.$minStorage"/>
              <param name="staticStorage" value="$src.$staticStorage"/>
              <param name="maxStorage" value="$src.$maxStorage"/>
              <param name="autowares" value="$src.$autowares"/>
              <param name="warebasket" value="$src.$warebasket"/>
              <param name="ignoretraderules" value="$src.$ignoretraderules"/>
              <param name="ignoreoffersettings" value="$src.$ignoreoffersettings"/>
              <param name="allowillegal" value="$src.$allowillegal"/>
              <param name="enforceRouteIllegalLegality" value="$src.$enforceRouteIllegalLegality"/>
              <param name="bidirectional" value="$src.$bidirectional"/>
              <param name="maxDistance" value="[$src.$maxDistance, $cap].min"/>
              <param name="supplierPriceRange" value="$src.$supplierPriceRange"/>
              <param name="fleetcoordination" value="$src.$fleetcoordination"/>
              <param name="logbookentries" value="$src.$logbookentries"/>
              <param name="notifications" value="$src.$notifications"/>
              <param name="debuglevel" value="$src.$debuglevel"/>
              <param name="allowlowvolume" value="$src.$allowlowvolume"/>
              <param name="lowvolumefloorpercent" value="$src.$lowvolumefloorpercent"/>
              <param name="idleParking" value="$src.$idleParking"/>
              <param name="autoJumpDistanceByLevel" value="$src.$autoJumpDistanceByLevel"/>
            </create_order>
          </do_elseif>
          <do_elseif value="$orderId == 'GalaxyTraderMK4Supply'">
            <create_order id="'GalaxyTraderMK4Supply'" object="$ship" default="true">
              <param name="home" value="$src.$home"/>
              <param name="assignHome" value="$src.$assignHome"/>
              <param name="jumpDistanceCoverage" value="$src.$jumpDistanceCoverage"/>
              <param name="jumpDistanceBuy" value="$src.$jumpDistanceBuy"/>
              <param name="serveHomeOnly" value="$src.$serveHomeOnly"/>
              <param name="buyFromPlayer" value="$src.$buyFromPlayer"/>
              <param name="buyFromFaction" value="$src.$buyFromFaction"/>
              <param name="priorityBuildstorage" value="$src.$priorityBuildstorage"/>
              <param name="priorityStations" value="$src.$priorityStations"/>
              <param name="priorityAux" value="$src.$priorityAux"/>
              <param name="allowResources" value="$src.$allowResources"/>
              <param name="allowIntermediates" value="$src.$allowIntermediates"/>
              <param name="allowTradewares" value="$src.$allowTradewares"/>
              <param name="autowares" value="$src.$autowares"/>
              <param name="warebasket" value="$src.$warebasket"/>
              <param name="priorityscoremultiplier" value="$src.$priorityscoremultiplier"/>
              <param name="prioritywares" value="$src.$prioritywares"/>
              <param name="maxTrades" value="$src.$maxTrades"/>
              <param name="backtrackTolerance" value="$src.$backtrackTolerance"/>
              <param name="useMinCargoThreshold" value="$src.$useMinCargoThreshold"/>
              <param name="minCargoUsed" value="$src.$minCargoUsed"/>
              <param name="allowSmallDestinationFills" value="$src.$allowSmallDestinationFills"/>
              <param name="minstorage" value="$src.$minstorage"/>
              <param name="allowillegal" value="$src.$allowillegal"/>
              <param name="enforceRouteIllegalLegality" value="$src.$enforceRouteIllegalLegality"/>
              <param name="ignoretraderules" value="$src.$ignoretraderules"/>
              <param name="ignoremk1supply" value="$src.$ignoremk1supply"/>
              <param name="logbookentries" value="$src.$logbookentries"/>
              <param name="idleParking" value="$src.$idleParking"/>
              <param name="autoJumpDistanceByLevel" value="$src.$autoJumpDistanceByLevel"/>
              <param name="sectorwhitelist" value="$src.$sectorwhitelist"/>
              <param name="stationwhitelist" value="$src.$stationwhitelist"/>
              <param name="stationblacklist" value="$src.$stationblacklist"/>
              <param name="distancepenalty" value="$src.$distancepenalty"/>
              <param name="fleetcoordination" value="$src.$fleetcoordination"/>
              <param name="marketupdatefreq" value="$src.$marketupdatefreq"/>
              <param name="debuglevel" value="$src.$debuglevel"/>
              <param name="tradeeval" value="$src.$tradeeval"/>
            </create_order>
          </do_elseif>

          <do_if value="@$ship.defaultorder.id == $orderId">
            <set_object_commander object="$ship" commander="$station" assignment="$assignment"/>
            <set_value name="$done" exact="$ship.commander == $station"/>
          </do_if>
        </do_if>

        <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
          <debug_text text="'[GT Promote] Station step ship=' + @$ship.idcode + ' order=' + $orderId + ' station=' + @$station.idcode + ' done=' + $done" chance="100"/>
        </do_if>
        <raise_lua_event name="'gt.promoteStationStepDone'" param="$ship"/>
      </actions>
    </cue>
  </cues>
</mdscript>
