<?xml version="1.0" encoding="utf-8"?>
<diff>
  <add sel="//aiscript[@name='order.repair']/init">
    <set_value name="$gtMaintenanceCycle" exact="@global.$GT_MaintenanceOrders.{this.ship}.$StartTime"/>
    <do_if value="@global.$GT_MaintenanceOrders.{this.ship} != null">
      <set_value name="global.$GT_MaintenanceOrders.{this.ship}.$WaitingForRepair" exact="true"/>
    </do_if>
  </add>


  <!-- GalaxyTrader MK3: Repair completion signalling patch -->
  <!-- GT_MaintenanceOrders stays WaitingForRepair until this signal arrives, so it must fire on every
       end of the order: after label finish (success, timeout and every resume label="finish" failure)
       and in on_abort (cancelled). ProcessRepairComplete only clears tracking, so a failed repair is
       retried by the next regular maintenance check. -->

  <add sel="//aiscript[@name='order.repair']/attention/actions/label[@name='finish']" pos="after">
    <do_if value="this.ship.isplayerowned and @global.$GT_MaintenanceOrders.{this.ship} != null">
      <do_if value="not global.$GT_RepairCompleteQueue?">
        <set_value name="global.$GT_RepairCompleteQueue" exact="[]"/>
      </do_if>
      <append_to_list name="global.$GT_RepairCompleteQueue" exact="table[
        $ship = this.ship,
        $Cycle = @$gtMaintenanceCycle,
        $pilot = this.ship.pilot,
        $timestamp = player.age
      ]"/>
      <signal_objects object="player.galaxy" param="'GT_RepairComplete'"/>
      <do_if value="@global.$GT_GlobalSettings.$Debug.$EnableDebugLogging">
        <debug_text text="'[GT-Repair] Repair order finished for ' + this.ship.idcode + ' (hull ' + this.ship.hullpercentage + '%), signalling completion'" chance="100"/>
      </do_if>
    </do_if>
  </add>

  <add sel="//aiscript[@name='order.repair']/on_abort">
    <do_if value="this.ship.isplayerowned and @global.$GT_MaintenanceOrders.{this.ship} != null">
      <do_if value="not global.$GT_RepairCompleteQueue?">
        <set_value name="global.$GT_RepairCompleteQueue" exact="[]"/>
      </do_if>
      <append_to_list name="global.$GT_RepairCompleteQueue" exact="table[
        $ship = this.ship,
        $Cycle = @$gtMaintenanceCycle,
        $pilot = this.ship.pilot,
        $timestamp = player.age
      ]"/>
      <signal_objects object="player.galaxy" param="'GT_RepairComplete'"/>
    </do_if>
  </add>
</diff>
