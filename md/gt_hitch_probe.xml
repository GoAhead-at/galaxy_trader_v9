<?xml version="1.0" encoding="utf-8"?>
<!-- Offline hitch probe. Not loaded from md/ - copy into galaxy_trader/md/ only while measuring,
     then remove. Pair with galaxy_trader/tools/analyze_hitch_probe.py on log.log. -->
<mdscript name="GT_HitchProbe" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../stock_game/X4 Foundations/libraries/md.xsd">
  <cues>
    <!-- Logs player.age every 100ms. Hitch signal = gaps between [GT-HitchProbe] lines in log.log. -->
    <cue name="HitchProbeTick" instantiate="true" version="1" checktime="player.age + 100ms" checkinterval="100ms">
      <actions>
        <debug_text text="'[GT-HitchProbe] age_ms=' + (player.age / 1ms)i" chance="100"/>
      </actions>
    </cue>
  </cues>
</mdscript>
